# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf
# Golden XML, such as Maven metadata, is compared byte for byte on every OS.
*.xml text eol=lf
# PyPI HTML goldens assert the exact response bytes on every OS.
internal/artifacts/ecosystem/pypi/http/testdata/*.html text eol=lf
# Schema goldens are compared with the migrated schema byte for byte on every OS.
internal/app/adapters/sql/sqlite/testdata/schema.golden text eol=lf
internal/app/adapters/sql/postgres/testdata/schema.golden text eol=lf
# The config validate goldens are compared with Config.String byte for byte on
# every OS.
internal/app/config/testdata/*.golden.yaml text eol=lf
# Opkg Packages records require a blank line after the final stanza.
internal/artifacts/ecosystem/opkg/testdata/openwrt-Packages text eol=lf whitespace=-blank-at-eof
# Nix cache text is native protocol data; CRLF is not a valid field delimiter.
*.narinfo text eol=lf
internal/artifacts/ecosystem/nix/testdata/cache/nix-cache-info text eol=lf
# txtar fixture archives: a file marker line that ends in CRLF is not a
# marker, so a CRLF checkout on Windows would parse as an archive with no files.
*.txtar text eol=lf
