# Repositories on artifactweave with the jfrog/artifactory provider: a local
# generic repository, properties on the repository itself and on one file in
# it.

resource "artifactory_local_generic_repository" "this" {
  key         = var.repository_key
  description = "managed by Terraform"
}

# The local generic repositories, as the repositories list reports them. The
# list names each package type as Artifactory's RepoType enumeration does,
# so the repository above reads back with package_type "Generic", not the
# "generic" it was created with.
data "artifactory_repositories" "generic" {
  repository_type = "local"
  package_type    = "generic"

  depends_on = [artifactory_local_generic_repository.this]
}

# Without item_path the provider sets the properties on the repository root,
# as its TestAccItemProperties_repo_only does. is_recursive stays false, so
# they stay on the repository and do not reach the files in it.
resource "artifactory_item_properties" "repository" {
  repo_key   = artifactory_local_generic_repository.this.key
  properties = var.repository_properties
}

# The provider cannot deploy content, so the file the properties go on is
# deployed between a first apply with with_properties = false and the full one.
resource "artifactory_item_properties" "this" {
  count      = var.with_properties ? 1 : 0
  repo_key   = artifactory_local_generic_repository.this.key
  item_path  = var.item_path
  properties = var.properties
}

# Local repositories for the package formats P7 serves (#261). Each sets its
# layout explicitly, and the Maven-family fields take values that differ from
# the provider's defaults where they can, so the empty plan after apply shows
# artifactweave stores and returns every field exactly as written.

resource "artifactory_local_npm_repository" "this" {
  key             = var.npm_repository_key
  description     = "managed by Terraform"
  repo_layout_ref = "npm-default"
}

resource "artifactory_local_go_repository" "this" {
  key             = var.go_repository_key
  description     = "managed by Terraform"
  repo_layout_ref = "go-default"
}

# A release repository: snapshots refused, checksums generated by the server.
resource "artifactory_local_maven_repository" "this" {
  key                             = var.maven_repository_key
  description                     = "managed by Terraform"
  repo_layout_ref                 = "maven-2-default"
  handle_releases                 = true
  handle_snapshots                = false
  snapshot_version_behavior       = "unique"
  max_unique_snapshots            = 0
  checksum_policy_type            = "server-generated-checksums"
  suppress_pom_consistency_checks = false
}

# A snapshot repository: releases refused, non-unique snapshots, at most five
# kept per version.
resource "artifactory_local_gradle_repository" "this" {
  key                             = var.gradle_repository_key
  description                     = "managed by Terraform"
  repo_layout_ref                 = "gradle-default"
  handle_releases                 = false
  handle_snapshots                = true
  snapshot_version_behavior       = "non-unique"
  max_unique_snapshots            = 5
  checksum_policy_type            = "client-checksums"
  suppress_pom_consistency_checks = true
}

# Local repositories for the package formats P8 serves (#526). Each sets its
# layout explicitly, and the NuGet, Helm and Helm OCI fields take values that
# differ from the provider's defaults, so the empty plan after apply shows
# artifactweave stores and returns them exactly as written.

resource "artifactory_local_pypi_repository" "this" {
  key             = var.pypi_repository_key
  description     = "managed by Terraform"
  repo_layout_ref = "simple-default"
}

# A feed that asks for credentials even to read, keeping at most ten
# snapshots of a package.
resource "artifactory_local_nuget_repository" "this" {
  key                        = var.nuget_repository_key
  description                = "managed by Terraform"
  repo_layout_ref            = "nuget-default"
  max_unique_snapshots       = 10
  force_nuget_authentication = true
}

# Both enforcement flags on. The provider refuses to change either once it
# is set, so turning one off means replacing the repository.
resource "artifactory_local_helm_repository" "this" {
  key                         = var.helm_repository_key
  description                 = "managed by Terraform"
  repo_layout_ref             = "simple-default"
  force_non_duplicate_chart   = true
  force_metadata_name_version = true
}

# At most ten tags per chart, and up to three overwritten tags kept by
# digest. The provider's tag_retention is dockerTagRetention in the
# repository's JSON.
resource "artifactory_local_helmoci_repository" "this" {
  key             = var.helmoci_repository_key
  description     = "managed by Terraform"
  repo_layout_ref = "simple-default"
  max_unique_tags = 10
  tag_retention   = 3
}

# The provider creates both Terraform registry repositories with
# packageType "terraform" and a lower-case terraformType, "module" or
# "provider", and never reads terraformType back.
resource "artifactory_local_terraform_module_repository" "this" {
  key             = var.terraform_module_repository_key
  description     = "managed by Terraform"
  repo_layout_ref = "terraform-module-default"
}

# A provider registry signs what it serves with a GPG key pair, the one
# below. Provider 12.11.14 has no primary_keypair_ref on this resource, so the
# pair is associated with the repository through the repositories API (see
# the README). The provider neither sends nor reads primaryKeyPairRef, so
# later applies keep the association.
resource "artifactory_local_terraform_provider_repository" "this" {
  key             = var.terraform_provider_repository_key
  description     = "managed by Terraform"
  repo_layout_ref = "terraform-provider-default"
}

# The provider cannot validate a GPG private key, so plan warns "Usage of GPG
# can't be validated"; the server checks that the two halves match.
resource "artifactory_keypair" "terraform_provider_signing" {
  pair_name   = var.gpg_keypair_name
  pair_type   = "GPG"
  alias       = var.gpg_keypair_name
  private_key = var.gpg_private_key
  public_key  = var.gpg_public_key
}

# A state store for Terraform's remote backend.
resource "artifactory_local_terraformbackend_repository" "this" {
  key             = var.terraform_backend_repository_key
  description     = "managed by Terraform"
  repo_layout_ref = "simple-default"
}

# Virtual repositories: an npm one over the local npm repository, deploying
# to it, and a Maven one with no members yet. The provider leaves an empty
# repositories list out of the request and reads it back as an empty list,
# so the empty plan after apply proves both.
resource "artifactory_virtual_npm_repository" "this" {
  key                     = var.npm_virtual_repository_key
  description             = "managed by Terraform"
  repositories            = [artifactory_local_npm_repository.this.key]
  default_deployment_repo = artifactory_local_npm_repository.this.key
}

resource "artifactory_virtual_maven_repository" "empty" {
  key          = var.maven_virtual_repository_key
  description  = "managed by Terraform"
  repositories = []
}
