table access_federation_targets access_federation_targets CREATE TABLE access_federation_targets(name TEXT PRIMARY KEY,peer TEXT NOT NULL,active BOOLEAN NOT NULL DEFAULT FALSE,created_at BIGINT,entities TEXT,permission_filters TEXT,group_filters TEXT)
table api_replays api_replays CREATE TABLE api_replays(scope TEXT NOT NULL,key_hash TEXT NOT NULL,fingerprint TEXT NOT NULL,resource_id BIGINT NOT NULL,expires_at BIGINT NOT NULL,PRIMARY KEY(scope,key_hash))
table api_restriction_audit api_restriction_audit CREATE TABLE api_restriction_audit(id INTEGER PRIMARY KEY AUTOINCREMENT,user_name TEXT NOT NULL,actor TEXT NOT NULL,reason TEXT NOT NULL,until_at BIGINT,changed_at BIGINT NOT NULL)
table api_restrictions api_restrictions CREATE TABLE api_restrictions(user_name TEXT PRIMARY KEY REFERENCES users(name)ON DELETE CASCADE,id BIGINT NOT NULL,actor TEXT NOT NULL,reason TEXT NOT NULL,until_at BIGINT,changed_at BIGINT NOT NULL)
table applied_markers applied_markers CREATE TABLE applied_markers(origin TEXT NOT NULL,stream TEXT NOT NULL,last_seq BIGINT NOT NULL DEFAULT 0,PRIMARY KEY(origin,stream))
table archive_executions archive_executions CREATE TABLE archive_executions(id INTEGER PRIMARY KEY AUTOINCREMENT,policy_key TEXT NOT NULL DEFAULT '',kind TEXT NOT NULL,state TEXT NOT NULL,started_at BIGINT,finished_at BIGINT,total BIGINT NOT NULL DEFAULT 0,completed BIGINT NOT NULL DEFAULT 0,failed BIGINT NOT NULL DEFAULT 0,total_bytes BIGINT NOT NULL DEFAULT 0,success_bytes BIGINT NOT NULL DEFAULT 0,failure_bytes BIGINT NOT NULL DEFAULT 0,triggered_by TEXT NOT NULL DEFAULT '',destination TEXT)
table archive_policies archive_policies CREATE TABLE archive_policies(key TEXT PRIMARY KEY,family TEXT NOT NULL,description TEXT NOT NULL DEFAULT '',enabled BOOLEAN NOT NULL DEFAULT FALSE,cron_exp TEXT NOT NULL DEFAULT '',project_key TEXT NOT NULL DEFAULT '',duration_minutes INTEGER NOT NULL DEFAULT 0,expiration_months INTEGER NOT NULL DEFAULT 0,skip_trashcan BOOLEAN NOT NULL DEFAULT FALSE,created_at BIGINT,updated_at BIGINT,criteria TEXT)
table archived_items archived_items CREATE TABLE archived_items(id INTEGER PRIMARY KEY AUTOINCREMENT,namespace TEXT NOT NULL DEFAULT '',repo_key TEXT NOT NULL,path TEXT NOT NULL,name TEXT NOT NULL,depth INTEGER NOT NULL DEFAULT 0,sha256 TEXT NOT NULL DEFAULT '',sha512 TEXT NOT NULL DEFAULT '',sha1 TEXT NOT NULL DEFAULT '',md5 TEXT NOT NULL DEFAULT '',size BIGINT NOT NULL DEFAULT 0,created_at BIGINT,created_by TEXT NOT NULL DEFAULT '',modified_at BIGINT,modified_by TEXT NOT NULL DEFAULT '',package_type TEXT NOT NULL DEFAULT '',package_name TEXT NOT NULL DEFAULT '',package_version TEXT NOT NULL DEFAULT '',policy_key TEXT NOT NULL DEFAULT '',execution_id BIGINT NOT NULL DEFAULT 0,archived_at BIGINT,expires_at BIGINT,cold_blob_sha256 TEXT NOT NULL DEFAULT '',item TEXT NOT NULL,properties TEXT,stats TEXT)
table blob_replicas blob_replicas CREATE TABLE blob_replicas(sha256 TEXT NOT NULL,member TEXT NOT NULL,state TEXT NOT NULL,size BIGINT NOT NULL DEFAULT 0,attempts INTEGER NOT NULL DEFAULT 0,last_error TEXT NOT NULL DEFAULT '',updated_at BIGINT NOT NULL DEFAULT 0,PRIMARY KEY(sha256,member))
table blobs blobs CREATE TABLE blobs(sha256 TEXT PRIMARY KEY,sha512 TEXT NOT NULL DEFAULT '',sha1 TEXT NOT NULL DEFAULT '',md5 TEXT NOT NULL DEFAULT '',size BIGINT NOT NULL,created_at BIGINT,ref_count BIGINT NOT NULL DEFAULT 0,state TEXT NOT NULL DEFAULT 'live',deleted_at BIGINT)
table bower_registrations bower_registrations CREATE TABLE bower_registrations(repo_key TEXT NOT NULL REFERENCES repositories(key)ON DELETE CASCADE,name TEXT NOT NULL,url TEXT NOT NULL,PRIMARY KEY(repo_key,name))
table build_artifacts build_artifacts CREATE TABLE build_artifacts(build_id BIGINT NOT NULL,module_position INTEGER NOT NULL,position INTEGER NOT NULL,name TEXT NOT NULL DEFAULT '',type TEXT NOT NULL DEFAULT '',path TEXT NOT NULL DEFAULT '',sha1 TEXT NOT NULL DEFAULT '',sha256 TEXT NOT NULL DEFAULT '',md5 TEXT NOT NULL DEFAULT '',PRIMARY KEY(build_id,module_position,position),FOREIGN KEY(build_id,module_position)REFERENCES build_modules(build_id,position)ON DELETE CASCADE)
table build_dependencies build_dependencies CREATE TABLE build_dependencies(build_id BIGINT NOT NULL,module_position INTEGER NOT NULL,position INTEGER NOT NULL,dependency_id TEXT NOT NULL DEFAULT '',name TEXT NOT NULL DEFAULT '',type TEXT NOT NULL DEFAULT '',path TEXT NOT NULL DEFAULT '',scopes TEXT,sha1 TEXT NOT NULL DEFAULT '',sha256 TEXT NOT NULL DEFAULT '',md5 TEXT NOT NULL DEFAULT '',PRIMARY KEY(build_id,module_position,position),FOREIGN KEY(build_id,module_position)REFERENCES build_modules(build_id,position)ON DELETE CASCADE)
table build_modules build_modules CREATE TABLE build_modules(build_id BIGINT NOT NULL,position INTEGER NOT NULL,module_id TEXT NOT NULL DEFAULT '',type TEXT NOT NULL DEFAULT '',PRIMARY KEY(build_id,position),FOREIGN KEY(build_id)REFERENCES builds(id)ON DELETE CASCADE)
table build_promotions build_promotions CREATE TABLE build_promotions(id INTEGER PRIMARY KEY AUTOINCREMENT,build_id BIGINT NOT NULL,created_at BIGINT,created_by TEXT NOT NULL DEFAULT '',status TEXT NOT NULL DEFAULT '',comment TEXT NOT NULL DEFAULT '',ci_user TEXT NOT NULL DEFAULT '',source_repo TEXT NOT NULL DEFAULT '',repo TEXT NOT NULL DEFAULT '',FOREIGN KEY(build_id)REFERENCES builds(id)ON DELETE CASCADE)
table build_properties build_properties CREATE TABLE build_properties(build_id BIGINT NOT NULL,module_position INTEGER NOT NULL,key TEXT NOT NULL,value TEXT NOT NULL,PRIMARY KEY(build_id,module_position,key,value),FOREIGN KEY(build_id)REFERENCES builds(id)ON DELETE CASCADE)
table build_retention build_retention CREATE TABLE build_retention(project_key TEXT NOT NULL DEFAULT '',name TEXT NOT NULL,count INTEGER NOT NULL DEFAULT 0,minimum_build_date BIGINT,delete_artifacts BOOLEAN NOT NULL DEFAULT FALSE,keep_numbers TEXT,PRIMARY KEY(project_key,name))
table builds builds CREATE TABLE builds(id INTEGER PRIMARY KEY AUTOINCREMENT,project_key TEXT NOT NULL DEFAULT '',name TEXT NOT NULL,number TEXT NOT NULL,started_at BIGINT NOT NULL,url TEXT NOT NULL DEFAULT '',created_at BIGINT,created_by TEXT NOT NULL DEFAULT '',modified_at BIGINT,modified_by TEXT NOT NULL DEFAULT '',document TEXT,UNIQUE(project_key,name,number,started_at))
table bundle_artifacts bundle_artifacts CREATE TABLE bundle_artifacts(bundle_name TEXT NOT NULL,bundle_version TEXT NOT NULL,target_path TEXT NOT NULL,source_path TEXT NOT NULL DEFAULT '',sha256 TEXT NOT NULL DEFAULT '',sha512 TEXT NOT NULL DEFAULT '',sha1 TEXT NOT NULL DEFAULT '',md5 TEXT NOT NULL DEFAULT '',size BIGINT NOT NULL DEFAULT 0,props TEXT,PRIMARY KEY(bundle_name,bundle_version,target_path),FOREIGN KEY(bundle_name,bundle_version)REFERENCES release_bundles(name,version)ON DELETE CASCADE)
table bundle_audits bundle_audits CREATE TABLE bundle_audits(id INTEGER PRIMARY KEY AUTOINCREMENT,bundle_name TEXT NOT NULL,bundle_version TEXT NOT NULL,operation TEXT NOT NULL,created_at BIGINT,created_by TEXT NOT NULL DEFAULT '')
table bundle_exports bundle_exports CREATE TABLE bundle_exports(bundle_name TEXT NOT NULL,bundle_version TEXT NOT NULL,status TEXT NOT NULL DEFAULT '',archive_sha256 TEXT NOT NULL DEFAULT '',created_at BIGINT,PRIMARY KEY(bundle_name,bundle_version),FOREIGN KEY(bundle_name,bundle_version)REFERENCES release_bundles(name,version)ON DELETE CASCADE)
table bundle_keeps bundle_keeps CREATE TABLE bundle_keeps(bundle_name TEXT NOT NULL,bundle_version TEXT NOT NULL,PRIMARY KEY(bundle_name,bundle_version),FOREIGN KEY(bundle_name,bundle_version)REFERENCES release_bundles(name,version)ON DELETE CASCADE)
table certificates certificates CREATE TABLE certificates(alias TEXT PRIMARY KEY,pem TEXT NOT NULL DEFAULT '',issued_to TEXT NOT NULL DEFAULT '',issued_by TEXT NOT NULL DEFAULT '',issued_on BIGINT,valid_until BIGINT,fingerprint TEXT NOT NULL DEFAULT '',private_key BLOB)
table cleanup_policies cleanup_policies CREATE TABLE cleanup_policies(key TEXT PRIMARY KEY,description TEXT NOT NULL DEFAULT '',cron_exp TEXT NOT NULL DEFAULT '',project_key TEXT NOT NULL DEFAULT '',item_type TEXT NOT NULL DEFAULT '',duration_minutes INTEGER NOT NULL DEFAULT 0,enabled BOOLEAN NOT NULL DEFAULT FALSE,skip_trashcan BOOLEAN NOT NULL DEFAULT FALSE,criteria TEXT,created_at BIGINT,created_by TEXT NOT NULL DEFAULT '',updated_at BIGINT,updated_by TEXT NOT NULL DEFAULT '')
table cleanup_runs cleanup_runs CREATE TABLE cleanup_runs(id INTEGER PRIMARY KEY AUTOINCREMENT,policy_key TEXT NOT NULL,trigger_id BIGINT NOT NULL DEFAULT 0,item_type TEXT NOT NULL DEFAULT '',status TEXT NOT NULL DEFAULT '',dry_run BOOLEAN NOT NULL DEFAULT FALSE,manual BOOLEAN NOT NULL DEFAULT FALSE,triggered_by TEXT NOT NULL DEFAULT '',started_at BIGINT,ended_at BIGINT,total_items BIGINT NOT NULL DEFAULT 0,cleaned_items BIGINT NOT NULL DEFAULT 0,cleaned_size BIGINT NOT NULL DEFAULT 0,report TEXT)
table cold_blob_replicas cold_blob_replicas CREATE TABLE cold_blob_replicas(sha256 TEXT NOT NULL,member TEXT NOT NULL,state TEXT NOT NULL,size BIGINT NOT NULL DEFAULT 0,attempts INTEGER NOT NULL DEFAULT 0,last_error TEXT NOT NULL DEFAULT '',updated_at BIGINT NOT NULL DEFAULT 0,PRIMARY KEY(sha256,member))
table cold_blobs cold_blobs CREATE TABLE cold_blobs(sha256 TEXT PRIMARY KEY,sha512 TEXT NOT NULL DEFAULT '',sha1 TEXT NOT NULL DEFAULT '',md5 TEXT NOT NULL DEFAULT '',size BIGINT NOT NULL,created_at BIGINT,ref_count BIGINT NOT NULL DEFAULT 0,state TEXT NOT NULL DEFAULT 'live',deleted_at BIGINT)
table config_documents config_documents CREATE TABLE config_documents(kind TEXT NOT NULL,key TEXT NOT NULL,enabled BOOLEAN NOT NULL DEFAULT FALSE,document TEXT,updated_at BIGINT,PRIMARY KEY(kind,key))
table config_secrets config_secrets CREATE TABLE config_secrets(kind TEXT NOT NULL,key TEXT NOT NULL,name TEXT NOT NULL,value BLOB,PRIMARY KEY(kind,key,name),FOREIGN KEY(kind,key)REFERENCES config_documents(kind,key)ON DELETE CASCADE)
table distribution_jobs distribution_jobs CREATE TABLE distribution_jobs(tracker_id BIGINT NOT NULL REFERENCES distribution_trackers(id)ON DELETE CASCADE,peer TEXT NOT NULL,status TEXT NOT NULL DEFAULT '',priority INTEGER NOT NULL DEFAULT 0,started_at BIGINT,finished_at BIGINT,error TEXT NOT NULL DEFAULT '',PRIMARY KEY(tracker_id,peer))
table distribution_trackers distribution_trackers CREATE TABLE distribution_trackers(id INTEGER PRIMARY KEY AUTOINCREMENT,bundle_name TEXT NOT NULL,bundle_version TEXT NOT NULL,kind TEXT NOT NULL,dry_run BOOLEAN NOT NULL DEFAULT FALSE,auto_create_repos BOOLEAN NOT NULL DEFAULT FALSE,status TEXT NOT NULL DEFAULT '',created_at BIGINT,created_by TEXT NOT NULL DEFAULT '',rules TEXT)
table environments environments CREATE TABLE environments(name TEXT PRIMARY KEY,project_key TEXT NOT NULL DEFAULT '')
table failed_blob_fetches failed_blob_fetches CREATE TABLE failed_blob_fetches(stream TEXT NOT NULL,sha256 TEXT NOT NULL,sha1 TEXT NOT NULL DEFAULT '',repo_key TEXT NOT NULL DEFAULT '',first_failed_at BIGINT,failures INTEGER NOT NULL DEFAULT 0,last_error TEXT NOT NULL DEFAULT '',PRIMARY KEY(stream,sha256))
table federation_members federation_members CREATE TABLE federation_members(repo_key TEXT NOT NULL,peer TEXT NOT NULL,base_url TEXT NOT NULL DEFAULT '',remote_repo_key TEXT NOT NULL DEFAULT '',enabled BOOLEAN NOT NULL DEFAULT TRUE,PRIMARY KEY(repo_key,peer))
table full_sync_runs full_sync_runs CREATE TABLE full_sync_runs(id INTEGER PRIMARY KEY AUTOINCREMENT,repo_key TEXT NOT NULL,peer TEXT NOT NULL,forced BOOLEAN NOT NULL DEFAULT FALSE,snapshot_seq BIGINT NOT NULL DEFAULT 0,started_at BIGINT,finished_at BIGINT,status TEXT NOT NULL DEFAULT '',result_paths TEXT)
table gitlfs_locks gitlfs_locks CREATE TABLE gitlfs_locks(id TEXT PRIMARY KEY,repo_key TEXT NOT NULL REFERENCES repositories(key)ON DELETE CASCADE,path TEXT NOT NULL,owner TEXT NOT NULL,locked_at BIGINT NOT NULL,UNIQUE(repo_key,path))
table group_members group_members CREATE TABLE group_members(group_name TEXT NOT NULL REFERENCES user_groups(name)ON DELETE CASCADE,user_name TEXT NOT NULL REFERENCES users(name)ON DELETE CASCADE,PRIMARY KEY(group_name,user_name))
table instance instance CREATE TABLE instance(id INTEGER PRIMARY KEY CHECK(id = 1),instance_id TEXT NOT NULL,public_key BLOB,private_key BLOB,namespace_id TEXT NOT NULL DEFAULT '',protocol_version INTEGER NOT NULL DEFAULT 0)
table item_properties item_properties CREATE TABLE item_properties(item_id BIGINT NOT NULL REFERENCES items(id)ON DELETE CASCADE,key TEXT NOT NULL,value TEXT NOT NULL,PRIMARY KEY(item_id,key,value))
table item_stats item_stats CREATE TABLE item_stats(item_id BIGINT PRIMARY KEY REFERENCES items(id)ON DELETE CASCADE,download_count BIGINT NOT NULL DEFAULT 0,last_downloaded_at BIGINT,last_downloaded_by TEXT NOT NULL DEFAULT '',remote_download_count BIGINT NOT NULL DEFAULT 0,remote_last_downloaded_at BIGINT,remote_last_downloaded_by TEXT NOT NULL DEFAULT '',remote_origin TEXT NOT NULL DEFAULT '',remote_path TEXT NOT NULL DEFAULT '')
table items items CREATE TABLE items(id INTEGER PRIMARY KEY AUTOINCREMENT,repo_key TEXT NOT NULL,cached BOOLEAN NOT NULL,path TEXT NOT NULL,name TEXT NOT NULL,depth INTEGER NOT NULL,type TEXT NOT NULL,size BIGINT NOT NULL DEFAULT 0,sha256 TEXT NOT NULL DEFAULT '',sha512 TEXT NOT NULL DEFAULT '',sha1 TEXT NOT NULL DEFAULT '',md5 TEXT NOT NULL DEFAULT '',original_sha256 TEXT NOT NULL DEFAULT '',original_sha512 TEXT NOT NULL DEFAULT '',original_sha1 TEXT NOT NULL DEFAULT '',original_md5 TEXT NOT NULL DEFAULT '',mime_type TEXT NOT NULL DEFAULT '',created_at BIGINT,created_by TEXT NOT NULL DEFAULT '',modified_at BIGINT,modified_by TEXT NOT NULL DEFAULT '',updated_at BIGINT,remote_url TEXT NOT NULL DEFAULT '',props_modified_at BIGINT)
table keypairs keypairs CREATE TABLE keypairs(name TEXT PRIMARY KEY,type TEXT NOT NULL DEFAULT '',alias TEXT NOT NULL DEFAULT '',public_key TEXT NOT NULL DEFAULT '',private_key BLOB,passphrase BLOB)
table leases leases CREATE TABLE leases(name TEXT PRIMARY KEY,holder TEXT NOT NULL,task TEXT NOT NULL DEFAULT '',acquired_at BIGINT,expires_at BIGINT NOT NULL)
table outbox outbox CREATE TABLE outbox(origin TEXT NOT NULL,stream TEXT NOT NULL,seq BIGINT NOT NULL,hlc_wall BIGINT NOT NULL,hlc_logical BIGINT NOT NULL,event_type TEXT NOT NULL DEFAULT '',payload BLOB,blob_sha256 TEXT NOT NULL DEFAULT '',blob_size BIGINT NOT NULL DEFAULT 0,created_at BIGINT,PRIMARY KEY(origin,stream,seq))
table outbox_sequences outbox_sequences CREATE TABLE outbox_sequences(origin TEXT NOT NULL,stream TEXT NOT NULL,last_seq BIGINT NOT NULL DEFAULT 0,PRIMARY KEY(origin,stream))
table package_version_files package_version_files CREATE TABLE package_version_files(version_id BIGINT NOT NULL REFERENCES package_versions(id)ON DELETE CASCADE,item_id BIGINT NOT NULL REFERENCES items(id)ON DELETE CASCADE,PRIMARY KEY(version_id,item_id))
table package_versions package_versions CREATE TABLE package_versions(id INTEGER PRIMARY KEY AUTOINCREMENT,package_id BIGINT NOT NULL REFERENCES packages(id)ON DELETE CASCADE,version TEXT NOT NULL,order_key BIGINT NOT NULL DEFAULT 0,created_at BIGINT,last_downloaded_at BIGINT,metadata TEXT)
table packages packages CREATE TABLE packages(id INTEGER PRIMARY KEY AUTOINCREMENT,repo_key TEXT NOT NULL,package_type TEXT NOT NULL DEFAULT '',name TEXT NOT NULL,created_at BIGINT)
table pairing_nonces pairing_nonces CREATE TABLE pairing_nonces(nonce_hash BLOB PRIMARY KEY,use_case TEXT NOT NULL,expires_at BIGINT,redeemed_at BIGINT)
table peer_cursors peer_cursors CREATE TABLE peer_cursors(peer TEXT NOT NULL,stream TEXT NOT NULL,acked_seq BIGINT NOT NULL DEFAULT 0,last_sent_at BIGINT,last_error TEXT NOT NULL DEFAULT '',PRIMARY KEY(peer,stream))
table peer_use_cases peer_use_cases CREATE TABLE peer_use_cases(peer TEXT NOT NULL REFERENCES peers(instance_id)ON DELETE CASCADE,use_case TEXT NOT NULL,PRIMARY KEY(peer,use_case))
table peers peers CREATE TABLE peers(instance_id TEXT PRIMARY KEY,base_url TEXT NOT NULL DEFAULT '',public_key BLOB,protocol_version INTEGER NOT NULL DEFAULT 0,status TEXT NOT NULL DEFAULT '',last_seen_at BIGINT,display_name TEXT NOT NULL DEFAULT '',city_name TEXT NOT NULL DEFAULT '',country_code TEXT NOT NULL DEFAULT '',edge_role BOOLEAN NOT NULL DEFAULT FALSE)
table permission_grants permission_grants CREATE TABLE permission_grants(permission_name TEXT NOT NULL REFERENCES permissions(name)ON DELETE CASCADE,resource_type TEXT NOT NULL,principal_type TEXT NOT NULL,principal_name TEXT NOT NULL,actions INTEGER NOT NULL,PRIMARY KEY(permission_name,resource_type,principal_type,principal_name))
table permission_targets permission_targets CREATE TABLE permission_targets(permission_name TEXT NOT NULL REFERENCES permissions(name)ON DELETE CASCADE,resource_type TEXT NOT NULL,target TEXT NOT NULL,include_patterns TEXT,exclude_patterns TEXT,PRIMARY KEY(permission_name,resource_type,target))
table permissions permissions CREATE TABLE permissions(name TEXT PRIMARY KEY,description TEXT NOT NULL DEFAULT '',created_at BIGINT,updated_at BIGINT,resources TEXT)
table platform_federations platform_federations CREATE TABLE platform_federations(id TEXT PRIMARY KEY,name TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',connection_groups TEXT,entities TEXT)
table project_members project_members CREATE TABLE project_members(project_key TEXT NOT NULL REFERENCES projects(key)ON DELETE CASCADE,principal_type TEXT NOT NULL,principal_name TEXT NOT NULL,roles TEXT,PRIMARY KEY(project_key,principal_type,principal_name))
table project_repositories project_repositories CREATE TABLE project_repositories(repo_key TEXT PRIMARY KEY,project_key TEXT NOT NULL DEFAULT '',environments TEXT,shared_with_all BOOLEAN NOT NULL DEFAULT FALSE,shared_read_only BOOLEAN NOT NULL DEFAULT FALSE,updated_at BIGINT)
table project_repository_shares project_repository_shares CREATE TABLE project_repository_shares(repo_key TEXT NOT NULL REFERENCES project_repositories(repo_key)ON DELETE CASCADE,project_key TEXT NOT NULL,PRIMARY KEY(repo_key,project_key))
table projects projects CREATE TABLE projects(key TEXT PRIMARY KEY,display_name TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',storage_quota_bytes BIGINT NOT NULL DEFAULT 0,soft_limit BOOLEAN NOT NULL DEFAULT FALSE,quota_email BOOLEAN NOT NULL DEFAULT FALSE,admin_privileges TEXT)
table release_bundles release_bundles CREATE TABLE release_bundles(name TEXT NOT NULL,version TEXT NOT NULL,state TEXT NOT NULL,storing_repo TEXT NOT NULL DEFAULT '',project_key TEXT NOT NULL DEFAULT '',origin TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',created_at BIGINT,created_by TEXT NOT NULL DEFAULT '',signed_at BIGINT,signing_key_alias TEXT NOT NULL DEFAULT '',signature BLOB,notes TEXT,spec TEXT,PRIMARY KEY(name,version))
table remote_cache remote_cache CREATE TABLE remote_cache(repo_key TEXT NOT NULL REFERENCES repositories(key)ON DELETE CASCADE,cache_id TEXT NOT NULL,path TEXT NOT NULL,doc TEXT NOT NULL,PRIMARY KEY(repo_key,cache_id))
table remote_sources remote_sources CREATE TABLE remote_sources(repo_key TEXT PRIMARY KEY REFERENCES repositories(key)ON DELETE CASCADE,doc TEXT NOT NULL)
table replication_runs replication_runs CREATE TABLE replication_runs(replication_key TEXT NOT NULL REFERENCES replications(replication_key)ON DELETE CASCADE,started_at BIGINT NOT NULL,completed_at BIGINT,status TEXT NOT NULL DEFAULT '',PRIMARY KEY(replication_key,started_at))
table replications replications CREATE TABLE replications(replication_key TEXT PRIMARY KEY,repo_key TEXT NOT NULL,url TEXT NOT NULL DEFAULT '',username TEXT NOT NULL DEFAULT '',password BLOB,enabled BOOLEAN NOT NULL DEFAULT FALSE,cron_exp TEXT NOT NULL DEFAULT '',event_replication BOOLEAN NOT NULL DEFAULT FALSE,sync_deletes BOOLEAN NOT NULL DEFAULT FALSE,sync_properties BOOLEAN NOT NULL DEFAULT FALSE,sync_statistics BOOLEAN NOT NULL DEFAULT FALSE,include_prefix TEXT NOT NULL DEFAULT '',exclude_prefix TEXT NOT NULL DEFAULT '',proxy TEXT NOT NULL DEFAULT '',disable_proxy BOOLEAN NOT NULL DEFAULT FALSE,check_binary_existence BOOLEAN NOT NULL DEFAULT FALSE,socket_timeout_ms BIGINT NOT NULL DEFAULT 0)
table repositories repositories CREATE TABLE repositories(key TEXT PRIMARY KEY,rclass TEXT NOT NULL,package_type TEXT NOT NULL DEFAULT '',project_key TEXT NOT NULL DEFAULT '',created_at BIGINT NOT NULL,updated_at BIGINT NOT NULL,doc TEXT NOT NULL,header_secrets_version INTEGER NOT NULL DEFAULT 0)
table repository_header_secrets repository_header_secrets CREATE TABLE repository_header_secrets(repo_key TEXT NOT NULL REFERENCES repositories(key)ON DELETE CASCADE,position INTEGER NOT NULL,name TEXT NOT NULL,value BLOB,PRIMARY KEY(repo_key,position))
table repository_keypairs repository_keypairs CREATE TABLE repository_keypairs(repo_key TEXT NOT NULL REFERENCES repositories(key)ON DELETE CASCADE,role TEXT NOT NULL,keypair_name TEXT NOT NULL,PRIMARY KEY(repo_key,role))
table repository_members repository_members CREATE TABLE repository_members(virtual_key TEXT NOT NULL REFERENCES repositories(key)ON DELETE CASCADE,member_key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(virtual_key,position))
table repository_secrets repository_secrets CREATE TABLE repository_secrets(repo_key TEXT PRIMARY KEY REFERENCES repositories(key)ON DELETE CASCADE,password BLOB NOT NULL)
table request_budget_guard request_budget_guard CREATE TABLE request_budget_guard(id BIGINT PRIMARY KEY CHECK(id = 1))
table request_budgets request_budgets CREATE TABLE request_budgets(key_hash TEXT PRIMARY KEY,used BIGINT NOT NULL CHECK(used >= 0),resets_at BIGINT NOT NULL)
table roles roles CREATE TABLE roles(project_key TEXT NOT NULL DEFAULT '',name TEXT NOT NULL,type TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',environments TEXT,actions TEXT,PRIMARY KEY(project_key,name))
table settings settings CREATE TABLE settings(key TEXT PRIMARY KEY,value TEXT NOT NULL)
table signing_keys signing_keys CREATE TABLE signing_keys(alias TEXT PRIMARY KEY,public_key TEXT NOT NULL DEFAULT '',private_key BLOB,passphrase BLOB,is_default BOOLEAN NOT NULL DEFAULT FALSE)
table sqlite_sequence sqlite_sequence CREATE TABLE sqlite_sequence(name,seq)
table tokens tokens CREATE TABLE tokens(id TEXT PRIMARY KEY,subject TEXT NOT NULL DEFAULT '',access_digest BLOB UNIQUE,refresh_digest BLOB UNIQUE,reference_digest BLOB UNIQUE,scope TEXT NOT NULL DEFAULT '',audience TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',project_key TEXT NOT NULL DEFAULT '',issued_at BIGINT NOT NULL DEFAULT 0,expires_at BIGINT,refreshable BOOLEAN NOT NULL DEFAULT FALSE,revocable BOOLEAN NOT NULL DEFAULT FALSE,last_used_at BIGINT,purpose TEXT NOT NULL DEFAULT '',secret BLOB,identity TEXT NOT NULL DEFAULT '')
table topologies topologies CREATE TABLE topologies(key TEXT PRIMARY KEY,name TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',created_at BIGINT,modified_at BIGINT)
table topology_sites topology_sites CREATE TABLE topology_sites(topology_key TEXT NOT NULL REFERENCES topologies(key)ON DELETE CASCADE,site_name TEXT NOT NULL,peer TEXT NOT NULL,PRIMARY KEY(topology_key,site_name))
table trash trash CREATE TABLE trash(id INTEGER PRIMARY KEY AUTOINCREMENT,original_repo_key TEXT NOT NULL,original_path TEXT NOT NULL,original_name TEXT NOT NULL,item_json TEXT NOT NULL,deleted_at BIGINT,deleted_by TEXT NOT NULL DEFAULT '')
table trusted_keys trusted_keys CREATE TABLE trusted_keys(kid TEXT PRIMARY KEY,alias TEXT UNIQUE,public_key TEXT NOT NULL DEFAULT '',fingerprint TEXT NOT NULL DEFAULT '',issued_on BIGINT,issued_by TEXT NOT NULL DEFAULT '',valid_until BIGINT)
table uploads uploads CREATE TABLE uploads(id TEXT PRIMARY KEY,backend TEXT NOT NULL DEFAULT '',repo_key TEXT NOT NULL DEFAULT '',path TEXT NOT NULL DEFAULT '',state BLOB,bytes BIGINT NOT NULL DEFAULT 0,started_at BIGINT,updated_at BIGINT)
table user_groups user_groups CREATE TABLE user_groups(name TEXT PRIMARY KEY,description TEXT NOT NULL DEFAULT '',auto_join BOOLEAN NOT NULL DEFAULT FALSE,admin_privileges BOOLEAN NOT NULL DEFAULT FALSE,realm TEXT NOT NULL DEFAULT '',realm_attributes TEXT NOT NULL DEFAULT '',external_id TEXT NOT NULL DEFAULT '',roles TEXT,search_name TEXT)
table users users CREATE TABLE users(name TEXT PRIMARY KEY,email TEXT NOT NULL DEFAULT '',password_hash BLOB,admin BOOLEAN NOT NULL DEFAULT FALSE,profile_updatable BOOLEAN NOT NULL DEFAULT FALSE,internal_password_disabled BOOLEAN NOT NULL DEFAULT FALSE,disable_ui_access BOOLEAN NOT NULL DEFAULT FALSE,realm TEXT NOT NULL DEFAULT '',status TEXT NOT NULL DEFAULT '',mfa TEXT NOT NULL DEFAULT '',last_logged_in_at BIGINT,created_at BIGINT,roles TEXT,failed_logins INTEGER NOT NULL DEFAULT 0,password_changed_at BIGINT,password_expired BOOLEAN NOT NULL DEFAULT FALSE,search_name TEXT)
table webhook_deliveries webhook_deliveries CREATE TABLE webhook_deliveries(id INTEGER PRIMARY KEY AUTOINCREMENT,webhook_key TEXT NOT NULL REFERENCES webhooks(key)ON DELETE CASCADE,event_id TEXT NOT NULL DEFAULT '',event_type TEXT NOT NULL DEFAULT '',attempted_at BIGINT,status INTEGER NOT NULL DEFAULT 0,elapsed_ms BIGINT NOT NULL DEFAULT 0,request TEXT,response TEXT)
table webhook_secrets webhook_secrets CREATE TABLE webhook_secrets(webhook_key TEXT NOT NULL REFERENCES webhooks(key)ON DELETE CASCADE,handler_index INTEGER NOT NULL,name TEXT NOT NULL,value BLOB,PRIMARY KEY(webhook_key,handler_index,name))
table webhooks webhooks CREATE TABLE webhooks(key TEXT PRIMARY KEY,project_key TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',enabled BOOLEAN NOT NULL DEFAULT FALSE,debug BOOLEAN NOT NULL DEFAULT FALSE,domain TEXT NOT NULL DEFAULT '',created_at BIGINT,updated_at BIGINT,doc TEXT)
table work_items work_items CREATE TABLE work_items(kind TEXT NOT NULL,key TEXT NOT NULL,payload TEXT,state TEXT NOT NULL,attempts INTEGER NOT NULL DEFAULT 0,generation BIGINT NOT NULL DEFAULT 0,not_before BIGINT NOT NULL,leased_by TEXT NOT NULL DEFAULT '',lease_until BIGINT,dirty_since BIGINT,last_error TEXT NOT NULL DEFAULT '',enqueued_at BIGINT NOT NULL,updated_at BIGINT NOT NULL,PRIMARY KEY(kind,key))
table worker_executions worker_executions CREATE TABLE worker_executions(id TEXT PRIMARY KEY,worker_key TEXT NOT NULL REFERENCES workers(key)ON DELETE CASCADE,action TEXT NOT NULL DEFAULT '',trigger_kind TEXT NOT NULL DEFAULT '',status TEXT NOT NULL DEFAULT '',started_at BIGINT NOT NULL,duration_ms BIGINT NOT NULL DEFAULT 0,payload BLOB,result BLOB,logs BLOB,error TEXT NOT NULL DEFAULT '')
table worker_secrets worker_secrets CREATE TABLE worker_secrets(worker_key TEXT NOT NULL REFERENCES workers(key)ON DELETE CASCADE,name TEXT NOT NULL,value BLOB,PRIMARY KEY(worker_key,name))
table worker_state worker_state CREATE TABLE worker_state(worker_key TEXT NOT NULL REFERENCES workers(key)ON DELETE CASCADE,key TEXT NOT NULL,value TEXT NOT NULL,PRIMARY KEY(worker_key,key))
table workers workers CREATE TABLE workers(key TEXT PRIMARY KEY,action TEXT NOT NULL,enabled BOOLEAN NOT NULL DEFAULT FALSE,debug BOOLEAN NOT NULL DEFAULT FALSE,shared BOOLEAN NOT NULL DEFAULT FALSE,project_key TEXT NOT NULL DEFAULT '',description TEXT NOT NULL DEFAULT '',source TEXT NOT NULL DEFAULT '',program_hash TEXT NOT NULL DEFAULT '',failures INTEGER NOT NULL DEFAULT 0,blocked_until BIGINT,created_at BIGINT,updated_at BIGINT,filter_doc TEXT)
rows request_budget_guard 1
