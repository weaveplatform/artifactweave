items.find({"path":{"$ne":"."},"$or":[{"path":{"$nmatch":"*"},"name":{"$nmatch":"*.pom"}}],"$or":[{"repo":{"$nmatch":"*.pom"},"path":{"$nmatch":"*"},"name":{"$nmatch":"*"}}],"$or":[{"$and":[{"repo":"libs-local","path":"org","name":{"$match":"acme*"}}]},{"$and":[{"repo":"libs-local","path":{"$match":"org/acme*"},"name":{"$match":"*"}}]}]}).include("name","repo","path","actual_md5","actual_sha1","sha256","size","type","modified","created","property")