# The edges of a move: a Go file that does not parse is rewritten as text,
# with a note; a generator of another package in the moved directory keeps
# its clause; a package of tests alone is named by its tests; a rename
# applies to a path that names the renamed file; "P/.." and a tracked file
# named like the package are not references; a parent directory with a file
# of its own does not move with its packages; and a package whose clause
# cannot be read, or an ownership inventory that does not decode, stops the
# move.
ok move -ticket PLT-70
stdout ^note: internal/broken/broken\.go does not parse, so its paths were rewritten as text: parse: \S
cmp internal/broken/broken.go want/broken.go
cmp migration/platform/delta2/gamma.go want/gamma.go
cmp migration/platform/delta2/gen.go want/gen.go
cmp internal/user/user.go want/user.go
commit
ok move -ticket PLT-71
cmp migration/platform/itest/suite_test.go want/suite_test.go
commit
ok move -ticket PLT-72
stdout ^check: no stale paths \(2 old paths checked\)$
cmp docs/notes.md want/notes.md
commit
fail move -ticket PLT-73
stderr ^pkgmove: read the package clause: internal/bad/bad\.go:1:1: expected .package., found \S
fail move -ticket PLT-74
stderr ^pkgmove: decode tools/citestselection/test_ownership\.json: json: unknown field "colour"$

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/bad","action":"move","to":"platform/bad","ticket":"PLT-73"},
        {"from":"internal/gamma","action":"move","to":"platform/delta2","ticket":"PLT-70"},
        {"from":"internal/hub/x","action":"move","to":"platform/hub/x","ticket":"PLT-72"},
        {"from":"internal/hub/y","action":"move","to":"platform/hub/y","ticket":"PLT-72"},
        {"from":"internal/integration","action":"move","to":"platform/itest","rename":{"integration_test.go":"suite_test.go"},"ticket":"PLT-71"},
        {"from":"internal/kap","action":"move","to":"platform/kap","ticket":"PLT-74"}
    ],
    "files": [],
    "placeholders": []
}
-- internal/gamma/gamma.go --
