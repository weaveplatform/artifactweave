# An external test sees what the in-package test files of its own package
# declare, export_test.go among them. When an export_test.go and an external
# test that uses one of its names move to one directory, fix points the
# test's old.X at the new package and imports it there, rather than telling
# it that X moved with a test file. A test left in the old package that uses
# X is still reported: no file there declares it any more.
ok move -ticket PLT-41
commit
! go vet ./migration/...
fail fix -ticket PLT-41
cmpout want/plan
cmp migration/platform/fresh/use_test.go want/use_test.go
go vet ./migration/...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/core","action":"split","ticket":"PLT-41"}
    ],
    "files": [
        {"from":"internal/core/export_test.go","action":"move","to":"platform/fresh","ticket":"PLT-41"},
        {"from":"internal/core/fresh.go","action":"move","to":"platform/fresh","ticket":"PLT-41"},
        {"from":"internal/core/use_test.go","action":"move","to":"platform/fresh","ticket":"PLT-41"}
    ],
    "placeholders": []
}
-- internal/core/core.go --
// Package core counts.
package core

// Keep stays.
func Keep() int { return 1 }
-- internal/core/fresh.go --
package core

func secret() int { return 7 }
-- internal/core/export_test.go --
package core

var Secret = secret
-- internal/core/use_test.go --
package core_test

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/core"
)

func TestUnitUse(t *testing.T) {
	if core.Secret() != 7 {
		t.Fatal("secret")
	}
}
-- internal/core/stay_test.go --
package core_test

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/core"
)

func TestUnitStay(t *testing.T) {
	if core.Keep()+core.Secret() != 8 {
		t.Fatal("sum")
	}
}
-- want/plan --
  rewrite migration/platform/fresh/use_test.go: 1 import, 1 qualifier, 1 removed unused import
internal/core/stay_test.go:10: core.Secret moved with the test file migration/platform/fresh/export_test.go, which internal/core cannot import; move it into a file that is no test
run make fmt (format the rewritten files)
