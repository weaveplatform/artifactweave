# A legacy root can be a package itself, as each pkg/ root is. When that
# package moves, the documents that name it follow, but the root stays a
# legacy root until promotion, so the ledger's list of legacy roots keeps its
# path: move leaves the list alone and check does not report it. The fixture
# moves the one root that no real ledger entry names, so the repository's own
# stale check never reports this file.
ok move -ticket PLT-01
runs make fmt
stdout ^check: no stale paths \(1 old paths checked\)$
exists migration/platform/core/core.go
cmp migration/devtools/ledger/ledger.go want/ledger.go
cmp docs/guide.md want/guide.md
commit
ok check
stdout ^check: no stale paths \(1 old paths checked\)$
ok status internal
stdout ^internal -> migration/platform/core \(done, PLT-01\)$

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal","action":"move","to":"platform/core","ticket":"PLT-01"}
    ],
    "files": [],
    "placeholders": []
}
-- migration/devtools/ledger/ledger.go --
// Package ledger names the legacy roots.
package ledger

// LegacyRoots are the directories that hold the legacy packages.
var LegacyRoots = []string{"internal"}
-- internal/core.go --
// Package core is a legacy root and a package.
package core
-- docs/guide.md --
The core lives in internal.
-- want/ledger.go --
// Package ledger names the legacy roots.
package ledger

// LegacyRoots are the directories that hold the legacy packages.
var LegacyRoots = []string{"internal"}
-- want/guide.md --
The core lives in migration/platform/core.
