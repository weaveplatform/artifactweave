# A merge carries several legacy packages into one target. Two files that
# would land on one name, or a file that would land on a tracked file, stop
# the move; a rename in the ledger resolves the collision. A file that
# imported two of the merged packages keeps one import of the target.
fail move -ticket PLT-20
stderr ^pkgmove: refused: internal/m1/util\.go and internal/m2/util\.go would both move to migration/platform/merged/util\.go; give one a rename in the ledger$
fail move -ticket PLT-21
stderr ^pkgmove: refused: internal/m3/README\.md would overwrite the tracked file migration/platform/m3/README\.md$
ok move -ticket PLT-22
cmpout want/plan
cmp internal/user/user.go want/user.go
cmp migration/platform/m45/util5.go want/util5.go
go vet ./...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/m1","action":"merge","to":"platform/merged","ticket":"PLT-20"},
        {"from":"internal/m2","action":"merge","to":"platform/merged","ticket":"PLT-20"},
        {"from":"internal/m3","action":"move","to":"platform/m3","ticket":"PLT-21"},
        {"from":"internal/m4","action":"merge","to":"platform/m45","ticket":"PLT-22"},
        {"from":"internal/m5","action":"merge","to":"platform/m45","rename":{"util.go":"util5.go"},"ticket":"PLT-22"}
    ],
    "files": [],
    "placeholders": []
}
-- internal/m1/util.go --
package m1
-- internal/m2/util.go --
package m2
-- internal/m3/m3.go --
package m3
-- internal/m3/README.md --
m3
-- migration/platform/m3/README.md --
the target's own README
-- internal/m4/util.go --
// Package m4 is merged.
package m4

// A is a.
const A = "a"
-- internal/m5/util.go --
// Package m5 is merged.
package m5

// B is b.
const B = "b"
-- internal/user/user.go --
// Package user uses both merged packages.
package user

import (
	"github.com/weaveplatform/artifactweave/internal/m4"
	"github.com/weaveplatform/artifactweave/internal/m5"
)

// AB is both.
const AB = m4.A + m5.B
-- want/plan --
move internal/m4 -> migration/platform/m45 (package m4 becomes m45) [PLT-22]
move internal/m5 -> migration/platform/m45 (package m5 becomes m45) [PLT-22]
  git mv internal/m4/util.go migration/platform/m45/util.go
  git mv internal/m5/util.go migration/platform/m45/util5.go
  rewrite internal/m4/util.go (at migration/platform/m45/util.go): 1 package clause
  rewrite internal/m5/util.go (at migration/platform/m45/util5.go): 1 package clause
  rewrite internal/user/user.go: 2 imports, 2 qualifiers, 1 removed repeated import
regenerate: make fmt (format the changed files)
run make fmt (format the changed files)
check: no stale paths (2 old paths checked)
-- want/user.go --
// Package user uses both merged packages.
package user

import (
	"github.com/weaveplatform/artifactweave/migration/platform/m45"
)

// AB is both.
const AB = m45.A + m45.B
-- want/util5.go --
// Package m45 is merged.
package m45

// B is b.
const B = "b"
