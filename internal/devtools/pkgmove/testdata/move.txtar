# A ticket's move: the package, its tests and assets travel, the clause and
# every importer follow, qualifiers are renamed where no other name is in the
# way, build-tagged files are typed under their own GOOS and tags, a file no
# build compiles keeps the old name, and paths in Go and Markdown follow
# while subpackages, siblings, history and the prefixes of a package that
# still has pending subpackages stay.
ok move -ticket PLT-01 -dry-run
cmpout want/plan
git status --porcelain
! stdout .

ok move -ticket PLT-01
runs make fmt
stdout ^check: no stale paths \(1 old paths checked\)$
exists migration/platform/beta/alpha.go migration/platform/beta/testdata/greeting.txt migration/platform/beta/migrations/0001_init.sql internal/alpha/sub/sub.go
! exists internal/alpha/alpha.go internal/alpha/testdata
cmp migration/platform/beta/alpha.go want/alpha.go
cmp migration/platform/beta/alpha_test.go want/alpha_test.go
cmp migration/platform/beta/x_test.go want/x_test.go
cmp migration/platform/beta/migrations/0001_init.sql want/0001_init.sql
cmp internal/user/user.go want/user.go
cmp internal/user/conflict.go want/conflict.go
cmp internal/user/user_windows.go want/user_windows.go
cmp internal/user/user_e2e_test.go want/user_e2e_test.go
cmp internal/user/gen.go want/gen.go
cmp internal/winonly/winonly_windows.go want/winonly_windows.go
cmp docs/guide.md want/guide.md
cmp CHANGELOG.md want/CHANGELOG.md
cmp docs/research/notes.md want/notes.md
go vet ./...
go vet -tags=e2e ./...
commit

ok status internal/alpha/alpha_test.go
stdout ^internal/alpha/alpha_test.go -> migration/platform/beta/alpha_test.go \(done, PLT-01\)$
ok status internal/alpha/sub
stdout ^internal/alpha/sub \(pending, PLT-02; moves to migration/platform/beta/sub\)$
ok check
stdout ^check: no stale paths \(1 old paths checked\)$

# Once the subpackage follows, everything below internal/alpha has moved
# alike, so its prefix and its /... pattern move too.
ok move -ticket PLT-02
stdout ^check: no stale paths \(2 old paths checked\)$
cmp docs/guide.md want/guide2.md
go vet ./...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/alpha","action":"move","to":"platform/beta","ticket":"PLT-01"},
        {"from":"internal/alpha/sub","action":"move","to":"platform/beta/sub","ticket":"PLT-02"}
    ],
    "files": [],
    "placeholders": []
}
-- migration/README.md --
The staging root. Its history mentions internal/alpha.
-- CHANGELOG.md --
- Nothing has moved from internal/alpha yet.
-- docs/research/notes.md --
internal/alpha was written here, and stays so.
-- docs/guide.md --
# Guide

The greeting lives in internal/alpha, its fixture in `internal/alpha/testdata/greeting.txt`
and the names in internal/alpha/sub, which keeps its own entry.
Not to be confused with internal/alphabet or pkg/x/internal/alpha.
Every package below internal/alpha/ has an entry; ./internal/alpha/... lists them.
See [the code](../internal/alpha/alpha.go) and github.com/weaveplatform/artifactweave/internal/alpha.
-- internal/alpha/alpha.go --
// Package alpha says hello. Its fixture is internal/alpha/testdata/greeting.txt.
package alpha

import "github.com/weaveplatform/artifactweave/internal/alpha/sub"

// Hello returns a greeting.
func Hello() string { return "hello " + sub.Name }
-- internal/alpha/alpha_test.go --
package alpha

import (
	"os"
	"testing"
)

func TestHello(t *testing.T) {
	if Hello() == "" {
		t.Fatal("no greeting")
	}
	name := "greeting.txt"
	_, _ = os.ReadFile("internal/alpha/testdata/" + name)
	_ = map[string]string{"internal/alpha/alpha_test.go": "a test file path"}
}
-- internal/alpha/x_test.go --
package alpha_test

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/alpha"
)

func TestExternal(t *testing.T) {
	if alpha.Hello() == "" {
		t.Fatal("no greeting")
	}
}
-- internal/alpha/testdata/greeting.txt --
hello
-- internal/alpha/migrations/0001_init.sql --
-- The table of internal/alpha.
CREATE TABLE greeting (id int);
-- internal/alpha/sub/sub.go --
// Package sub names things.
package sub

// Name is a name.
const Name = "sub"
-- internal/alphabet/alphabet.go --
// Package alphabet is a sibling whose name starts like alpha's.
package alphabet

// Letters are letters.
const Letters = "abc"
-- internal/user/user.go --
// Package user greets.
package user

import (
	"github.com/weaveplatform/artifactweave/internal/alpha"
	"github.com/weaveplatform/artifactweave/internal/alphabet"
)

// Greet greets.
func Greet() string { return alpha.Hello() + alphabet.Letters }
-- internal/user/conflict.go --
package user

import "github.com/weaveplatform/artifactweave/internal/alpha"

// Twice greets twice; beta is in the way of the second use.
func Twice() string {
	beta := alpha.Hello()
	return beta + alpha.Hello()
}
-- internal/user/user_windows.go --
package user

import "github.com/weaveplatform/artifactweave/internal/alpha"

// Windows greets on Windows.
func Windows() string { return alpha.Hello() }
-- internal/user/user_e2e_test.go --
//go:build e2e

package user

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/alpha"
)

func TestEndToEnd(t *testing.T) {
	if alpha.Hello() == "" {
		t.Fatal("no greeting")
	}
}
-- internal/user/gen.go --
//go:build ignore

package main

import (
	"fmt"

	"github.com/weaveplatform/artifactweave/internal/alpha"
)

func main() { fmt.Println(alpha.Hello()) }
