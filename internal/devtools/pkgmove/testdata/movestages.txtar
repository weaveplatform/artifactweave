# A ticket may move its file entries in one run and its package entries in a
# later one, once its split entries have become moves in the ledger: a done
# entry of a ticket that still has pending entries is named in a notice and
# left where it is. A ticket with nothing left pending is refused, naming its
# first done entry.
ok move -ticket STO-01
stdout ^note: internal/kit is a split entry; move carries only move and merge entries and file move entries$
exists migration/platform/sqltest/schema.go internal/kit/kit.go
grep migration/platform/sqltest/schema.go ^package sqltest$
commit
cp want/ledger.json migration/ledger.json
commit
ok move -ticket STO-01
stdout ^note: internal/kit/schema\.go is done; move leaves it where it is$
stdout ^move internal/kit -> migration/app/kit \[STO-01\]$
exists migration/app/kit/kit.go migration/platform/sqltest/schema.go
! exists internal/kit/kit.go
commit
fail move -ticket STO-01
stderr ^pkgmove: refused: internal/kit is done, not pending$

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/kit","action":"split","ticket":"STO-01"}
    ],
    "files": [
        {"from":"internal/kit/schema.go","action":"move","to":"platform/sqltest","ticket":"STO-01"}
    ],
    "placeholders": []
}
-- internal/kit/kit.go --
// Package kit opens stores for tests.
package kit

// Kit is kit.
const Kit = "kit"
-- internal/kit/schema.go --
// Package kit opens stores for tests.
package kit

// Schema is the schema.
const Schema = "schema"
-- migration/platform/sqltest/sqltest.go --
// Package sqltest runs store suites.
package sqltest
-- want/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/kit","action":"move","to":"app/kit","ticket":"STO-01"}
    ],
    "files": [
        {"from":"internal/kit/schema.go","action":"move","to":"platform/sqltest","ticket":"STO-01"}
    ],
    "placeholders": []
}
