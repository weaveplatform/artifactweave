# A moved in-package test that uses the package it left closes an import
# cycle once that package bridges to the test's new package: fix reports the
# cycle. -external converts the test to the external test package instead:
# the clause gets _test, the package's exported names its qualifier and
# import, and each unexported name the test uses is listed for an
# export_test.go shim (rule 14 of #935).
ok move -ticket PLT-14
cp want/bridge_kernel.go internal/old/auth/bridge_kernel.go
commit
go build ./...
fail fix -ticket PLT-14 -report-only
cmpout want/cycle
usage fix -ticket PLT-14 -external
stderr -external takes the test files to convert
usage fix -ticket PLT-14 migration/kernel/token_test.go
usage fix -ticket PLT-14 -external migration/kernel/token.go
stderr ^pkgmove: usage: -external: migration/kernel/token\.go is not a tracked test file of a package$
fail fix -ticket PLT-14 -external migration/kernel/token_test.go
cmpout want/converted
cmp migration/kernel/token_test.go want/token_test.go
fail fix -ticket PLT-14 -external migration/kernel/token_test.go
stderr ^pkgmove: refused: migration/kernel/token_test\.go is an external test already$

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/old/auth","action":"split","ticket":"PLT-13"}
    ],
    "files": [
        {"from":"internal/old/auth/token.go","action":"move","to":"kernel","ticket":"PLT-14"},
        {"from":"internal/old/auth/token_test.go","action":"move","to":"kernel","ticket":"PLT-14"}
    ],
    "placeholders": []
}
-- internal/old/auth/auth.go --
// Package auth logs users in.
package auth

// Login logs user in.
func Login(user string) Token { return Parse(user) }
-- internal/old/auth/token.go --
package auth

// Token is a token.
type Token string

const secret = "s"

// Parse parses a token.
func Parse(s string) Token { return Token(s + secret) }
-- internal/old/auth/token_test.go --
package auth

import "testing"

func TestUnitParse(t *testing.T) {
	if Parse("a") != Login("a") {
		t.Fatal(Parse("a"))
	}
	if Token(secret) == "" {
		t.Fatal("no secret")
	}
}
-- want/bridge_kernel.go --
// Bridge (P9d): declared in migration/kernel; PRO-02 deletes it.

package auth

import "github.com/weaveplatform/artifactweave/migration/kernel"

type Token = kernel.Token

var Parse = kernel.Parse
-- want/cycle --
  rewrite migration/kernel/token_test.go: 1 import, 1 qualifier
migration/kernel/token_test.go:6: importing internal/old/auth closes an import cycle (migration/kernel -> internal/old/auth -> migration/kernel); break it by hand, with a bridge or with an external test (fix -external)
report only: nothing changed
-- want/converted --
  rewrite migration/kernel/token_test.go: 2 imports, 4 qualifiers, 1 package clause
migration/kernel/token_test.go:9: uses the unexported const secret, which package kernel_test cannot see; give it an exported name in export_test.go
run make fmt (format the rewritten files)
-- want/token_test.go --
package kernel_test

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/old/auth"
	"github.com/weaveplatform/artifactweave/migration/kernel"
)

func TestUnitParse(t *testing.T) {
	if kernel.Parse("a") != auth.Login("a") {
		t.Fatal(kernel.Parse("a"))
	}
	if kernel.Token(secret) == "" {
		t.Fatal("no secret")
	}
}
