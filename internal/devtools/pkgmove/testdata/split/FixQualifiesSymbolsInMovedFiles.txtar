	if got := Page([]store.Record{{ID: "A"}}); got[0].ID != "a" {
		t.Fatal(got)
	}
}
-- want/store.go --
// Package store stores records.
package store

import "github.com/weaveplatform/artifactweave/migration/platform/norm"

// Limit is the most records a page holds.
const Limit = 10

// Record is a record.
type Record struct{ ID string }

// Clean normalises the record's ID.
func (r *Record) Clean() { r.ID = norm.Norm(r.ID) }
