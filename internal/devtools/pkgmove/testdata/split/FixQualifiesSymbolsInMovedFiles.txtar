report only: nothing changed
-- want/page.go --
package kernel

import (
	"github.com/weaveplatform/artifactweave/internal/store"
	"github.com/weaveplatform/artifactweave/migration/platform/norm"
)

// Page pages records.
func Page(rs []store.Record) []store.Record {
	if len(rs) > store.Limit {
		rs = rs[:store.Limit]
	}
	for i := range rs {
		rs[i].ID = norm.Norm(rs[i].ID)
	}
	return rs
}
-- want/page_test.go --
