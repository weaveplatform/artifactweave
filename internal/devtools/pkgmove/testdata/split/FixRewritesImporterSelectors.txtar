-- internal/blob/blob.go --
// Package blob opens blobs.
package blob

// Open opens a blob.
func Open() string { return "blob" }
-- internal/blob/digest.go --
package blob

// Algo names a digest algorithm.
type Algo string

// Digest digests s.
func Digest(s string) string { return "sha256:" + s }
-- migration/platform/digest/hash.go --
// Package digest digests.
package digest

import "github.com/weaveplatform/artifactweave/internal/blob"

// Hash names the hash.
func Hash() blob.Algo { return blob.Algo("sha256") }
-- internal/user/user.go --
// Package user uses what moved and what stayed.
package user

import "github.com/weaveplatform/artifactweave/internal/blob"

// User digests a blob.
func User() string { return blob.Digest(blob.Open()) }
-- internal/only/only.go --
// Package only uses only what moved.
package only

import "github.com/weaveplatform/artifactweave/internal/blob"

// Only digests a.
func Only(a blob.Algo) string { return blob.Digest(string(a)) }
-- internal/clash/clash.go --
// Package clash has a parameter named like the new package.
package clash

import "github.com/weaveplatform/artifactweave/internal/blob"

// Clash digests digest.
func Clash(digest string) string { return blob.Digest(digest) }
-- internal/clash/clash_test.go --
package clash

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/blob"
)

func TestUnitClash(t *testing.T) {
	if Clash("a") != blob.Digest("a") {
		t.Fatal(Clash("a"))
	}
}
