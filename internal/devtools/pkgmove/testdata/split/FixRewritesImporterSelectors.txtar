# fix points each importer's old.X at the package X moved to: the import is
# added, with an explicit name where the package's own name means something
# else at a use, and the old import goes once nothing uses it. In a file of
# the target package the qualifier goes. An importer that uses nothing that
# moved is neither loaded nor changed.
ok move -ticket PLT-09
commit
! go vet ./...
ok fix -ticket PLT-09
cmpout want/plan
cmp internal/user/user.go want/user.go
cmp internal/only/only.go want/only.go
cmp internal/clash/clash.go want/clash.go
cmp internal/clash/clash_test.go want/clash_test.go
cmp internal/alias/alias.go want/alias.go
cmp migration/platform/digest/hash.go want/hash.go
git status --porcelain internal/other
! stdout .
go vet ./...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
