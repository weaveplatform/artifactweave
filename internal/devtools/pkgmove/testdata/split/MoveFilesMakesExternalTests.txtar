# A moved test keeps its style: an in-package test takes the target's name
# and an external test the target's name with _test. In a directory whose
# tests are all external, as the server suites under test/server are, an
# in-package test becomes external too, and the plan says so.
ok move -ticket WEB-11 -dry-run
cmpout want/plan
ok move -ticket WEB-11
cmp test/server/npm/root_test.go want/root_test.go
cmp test/server/npm/ext_test.go want/ext_test.go
cmp migration/platform/kit/helper_test.go want/helper_test.go
go vet ./...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/web","action":"split","ticket":"WEB-01"}
    ],
    "files": [
        {"from":"internal/web/ext_test.go","action":"move","to":"test/server/npm","scope":"repo","ticket":"WEB-11"},
        {"from":"internal/web/helper_test.go","action":"move","to":"platform/kit","ticket":"WEB-11"},
        {"from":"internal/web/root_test.go","action":"move","to":"test/server/npm","scope":"repo","ticket":"WEB-11"}
    ],
    "placeholders": []
}
