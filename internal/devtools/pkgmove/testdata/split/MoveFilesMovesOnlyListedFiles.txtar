move file internal/alpha/assets/ -> migration/platform/beta/assets/ [PLT-05]
move file internal/alpha/moved.go -> migration/platform/beta/moved.go [PLT-05]
move file internal/alpha/moved_test.go -> migration/platform/beta/moved_test.go [PLT-05]
move file internal/alpha/old_name.go -> migration/platform/beta/renamed.go [PLT-05]
  git mv internal/alpha/assets/logo.txt migration/platform/beta/assets/logo.txt
  git mv internal/alpha/assets/sub/icon.txt migration/platform/beta/assets/sub/icon.txt
  git mv internal/alpha/moved.go migration/platform/beta/moved.go
  git mv internal/alpha/moved_test.go migration/platform/beta/moved_test.go
  git mv internal/alpha/old_name.go migration/platform/beta/renamed.go
  rewrite docs/arch.md: 3 paths
  rewrite internal/alpha/moved.go (at migration/platform/beta/moved.go): 1 package clause
  rewrite internal/alpha/moved_test.go (at migration/platform/beta/moved_test.go): 1 package clause
  rewrite internal/alpha/old_name.go (at migration/platform/beta/renamed.go): 1 package clause
