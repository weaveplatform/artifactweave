# A command line pkgmove cannot run exits 2 with the usage.
usage
stderr ^pkgmove: usage: no command$
stderr ^usage:$
usage frobnicate
stderr ^pkgmove: usage: unknown command "frobnicate"$
ok help
stdout ^usage:$
! stderr .
ok -h
stdout ^  pkgmove status  \[-ticket ID\] \[-json\] \[legacy-path\]$
usage move
stderr ^pkgmove: usage: move takes either -ticket or -from$
usage move -ticket PLT-01 -from migration/x -to migration/y
stderr ^pkgmove: usage: move takes either -ticket or -from$
usage move -from migration/x
stderr ^pkgmove: usage: -to and -name go with -from, which needs -to$
usage move -ticket PLT-01 -to migration/y
stderr ^pkgmove: usage: -to and -name go with -from, which needs -to$
usage move -ticket PLT-01 -name y
usage move -ticket PLT-01 extra
stderr ^pkgmove: usage: move takes no arguments$
usage move -bogus
stderr ^pkgmove: usage: move: flag provided but not defined: -bogus$
usage check -bogus
stderr ^pkgmove: usage: check: flag provided but not defined: -bogus$

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [],
    "files": [],
    "placeholders": []
}
