-- migration/kernel/kernel.go --
// Package kernel holds what every module shares.
package kernel

import "errors"

// ErrNotFound reports a missing record.
var ErrNotFound = errors.New("not found")

// DefaultLimit is the default page size.
const DefaultLimit = 50

// Page is a page request.
type Page struct{ Limit int }

// Default is the default page.
var Default = Page{Limit: DefaultLimit}

// Counter counts.
var Counter int

// Box boxes a value.
type Box[T any] struct{ V T }

// Pair pairs a key and a value.
type Pair[K comparable, V any] struct {
	Key K
	Val V
}

// Log logs msg.
func Log(msg string) { _ = msg }

// Differ counts s.
func Differ(s string) int { return len(s) }

// Join joins a and b.
func Join(a, b string) string { return a + b }

// Sum adds xs.
func Sum(xs ...int) int {
	n := 0
	for _, x := range xs {
		n += x
	}
	return n
}

// Trim cuts rows to limit.
func Trim[T any](rows []T, limit int) []T { return rows[:min(limit, len(rows))] }

// Pick swaps a and b.
func Pick[A, B any](a A, b B) (B, A) { return b, a }

// Same returns a.
func Same[A, B any](a, b A) A {
	_ = b
	return a
}
-- pkg/store/bridge_kernel.go --
// Bridge (P9d): declared in migration/kernel; PRO-02 deletes it.

package store

import "github.com/weaveplatform/artifactweave/migration/kernel"

var _ = kernel.DefaultLimit

type Own struct{}

type Fn = func() int

type Ints = kernel.Box[int]

type Flip[K comparable, V comparable] = kernel.Pair[V, K]

type Box[T any] = kernel.Box[T]

var Typed error = kernel.ErrNotFound

var Limit = kernel.Default.Limit

const Max = 10

var Yes = true

var Counter = kernel.Counter

func Log(msg string) { kernel.Log(msg) }

func Twice(s string) int {
	n := kernel.Differ(s)
	return n * 2
}

func Swap(a, b string) string { return kernel.Join(b, a) }

func Sum(xs ...int) int { return kernel.Sum() }

func Trim[T any](rows []T, limit int) []T { return kernel.Trim[T](rows, limit) }

func Pick[A, B any](a A, b B) (B, A) { return kernel.Pick[A](a, b) }

func Same[A, B any](a, b A) A { return kernel.Same[A, A](a, b) }
-- pkg/store/store.go --
// Package store stores records.
package store
-- internal/app/app.go --
// Package app uses every bridge.
package app

import "github.com/weaveplatform/artifactweave/pkg/store"

// App uses them.
func App() []any {
	store.Counter++
	p := &store.Counter
	store.Log("x")
	return []any{
		store.Own{}, store.Fn(nil), store.Ints{}, store.Flip[string, int]{}, store.Box[int]{V: 1},
		store.Typed, store.Limit, store.Max, store.Yes, p,
		store.Twice("x"), store.Swap("a", "b"), store.Sum(1, 2),
		store.Trim([]int{1, 2}, 1), store.Same[int, string](1, 2),
	}
}

// Picked picks.
func Picked() (string, int) { return store.Pick(1, "a") }
