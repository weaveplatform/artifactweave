// Package app uses every bridge.
package app

import (
	"github.com/weaveplatform/artifactweave/migration/kernel"
	"github.com/weaveplatform/artifactweave/pkg/store"
)

// App uses them.
func App() []any {
	store.Counter++
	p := &store.Counter
	kernel.Log("x")
	return []any{
		store.Own{}, store.Fn(nil), store.Ints{}, store.Flip[string, int]{}, kernel.Box[int]{V: 1},
		store.Typed, store.Limit, store.Max, store.Yes, p,
		store.Twice("x"), store.Swap("a", "b"), store.Sum(1, 2),
		kernel.Trim([]int{1, 2}, 1), store.Same[int, string](1, 2),
	}
}

// Picked picks.
func Picked() (string, int) { return kernel.Pick(1, "a") }
