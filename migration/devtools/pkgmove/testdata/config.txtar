# Every kind of configuration in the fixed list follows a move, in every
# spelling: the module path, $(MODULE) and ${MODULE}, a bare path after "^",
# "./" or a space, a /... pattern and a file below the package. A directory
# that is no entry itself but whose packages all move alike, as
# internal/web/demo, moves too. The changes under api/, in the format
# inventory and in a client recipe source ask for their regeneration steps.
ok move -ticket PLT-05 -dry-run
cmpout want/plan
ok move -ticket PLT-05
runs make generate; go run ./tools/formatinventory; make client-recipes; make fmt
stdout ^check: no stale paths \(4 old paths checked\)$
cmp Makefile want/Makefile
cmp Dockerfile want/Dockerfile
cmp .goreleaser.yaml want/.goreleaser.yaml
cmp .golangci.yml want/.golangci.yml
cmp .testcoverage.yml want/.testcoverage.yml
cmp .gitattributes want/.gitattributes
cmp .github/workflows/ci.yml want/ci.yml
cmp deploy/platform/terraform/aws/base/Makefile want/terraform.mk
cmp api/oapi-delta.yaml want/oapi-delta.yaml
cmp api/src/delta/paths.yaml want/paths.yaml
cmp api/delta.openapi.yaml want/delta.openapi.yaml
cmp tools/depsync/catalog.json want/catalog.json
cmp tools/depsync/sync.py want/sync.py
cmp test/acceptance/run.sh want/run.sh
cmp test/acceptance/features/delta.feature want/delta.feature
cmp docs/implementation/package-format-inventory.json want/inventory.json
cmp docs/client-recipes/src/delta.json want/recipe.json
cmp internal/other/migrations/0002_delta.sql want/0002_delta.sql
cmp internal/web/server.go want/server.go
cmp migration/platform/demo/a/a.gen.go want/a.gen.go
go vet ./...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/delta","action":"move","to":"platform/delta","ticket":"PLT-05"},
        {"from":"internal/web","action":"move","to":"gateway/server","ticket":"WEB-01"},
        {"from":"internal/web/demo/a","action":"move","to":"platform/demo/a","ticket":"PLT-05"},
        {"from":"internal/web/demo/b","action":"move","to":"platform/demo/b","ticket":"PLT-05"}
    ],
    "files": [],
    "placeholders": []
}
-- internal/delta/delta.go --
// Package delta holds the version.
package delta

// Version is set with -X.
var Version = "dev"
-- internal/delta/testdata/data.txt --
data
-- internal/web/demo/a/a.gen.go --
// Code generated by oapi-codegen. DO NOT EDIT.

// Package a is generated.
package a

// A is generated.
const A = "a"
-- internal/web/demo/b/b.gen.go --
// Code generated by oapi-codegen. DO NOT EDIT.

// Package b is generated.
package b

// B is generated.
const B = "b"
-- internal/web/server.go --
// Package server serves the generated servers of internal/web/demo.
package server

import (
	"github.com/weaveplatform/artifactweave/internal/delta"
	"github.com/weaveplatform/artifactweave/internal/web/demo/a"
	"github.com/weaveplatform/artifactweave/internal/web/demo/b"
)

// Names lists what is served.
func Names() []string { return []string{a.A, b.B, delta.Version} }
-- Makefile --
MODULE := github.com/weaveplatform/artifactweave
LDFLAGS := -X $(MODULE)/internal/delta.Version=$(VERSION)
GEN_PATHS := api/*.openapi.yaml internal/web/demo

generate:
	for s in a b; do go run ./tools/stubgen internal/web/demo/$$s/server.gen.go; done

test:
	go test ./internal/delta/... ./internal/web/...
-- Dockerfile --
RUN go build -ldflags "-X ${MODULE}/internal/delta.Version=dev" ./cmd/x
-- .goreleaser.yaml --
builds:
  - ldflags:
      - -X github.com/weaveplatform/artifactweave/internal/delta.Version={{.Version}}
-- .golangci.yml --
linters:
  exclusions:
    rules:
      - path: ^internal/delta/
        linters: [gosec]
-- .testcoverage.yml --
exclude:
  paths:
    - ^internal/web/demo/
    - ^internal/delta$
-- .gitattributes --
internal/delta/testdata/* -text
-- .github/workflows/ci.yml --
jobs:
  test:
    steps:
      - run: go test ./internal/delta
-- deploy/platform/terraform/aws/base/Makefile --
build:
	go build -ldflags "-X $(MODULE)/internal/delta.Version=$(VERSION)" ./cmd/x
-- api/oapi-delta.yaml --
package: delta
output: internal/delta/delta.gen.go
-- api/src/delta/paths.yaml --
x-go-type-import:
  path: github.com/weaveplatform/artifactweave/internal/delta
-- api/delta.openapi.yaml --
openapi: 3.0.3
x-go-type-import:
  path: github.com/weaveplatform/artifactweave/internal/delta
-- tools/depsync/catalog.json --
{"packages": ["internal/delta"]}
-- tools/depsync/sync.py --
PACKAGE = "internal/delta"
-- test/acceptance/run.sh --
go test ./internal/delta/...
-- test/acceptance/features/delta.feature --
# The steps read internal/delta/testdata/data.txt.
Feature: delta
-- docs/implementation/package-format-inventory.json --
{"route_file": "internal/delta/delta.go"}
-- docs/client-recipes/src/delta.json --
{"source": "internal/delta/delta.go"}
-- internal/other/migrations/0002_delta.sql --
-- Written for internal/delta.
SELECT 1;
-- want/plan --
move internal/delta -> migration/platform/delta [PLT-05]
move internal/web/demo/a -> migration/platform/demo/a [PLT-05]
move internal/web/demo/b -> migration/platform/demo/b [PLT-05]
  git mv internal/delta/delta.go migration/platform/delta/delta.go
  git mv internal/delta/testdata/data.txt migration/platform/delta/testdata/data.txt
  git mv internal/web/demo/a/a.gen.go migration/platform/demo/a/a.gen.go
  git mv internal/web/demo/b/b.gen.go migration/platform/demo/b/b.gen.go
  rewrite .gitattributes: 1 path
  rewrite .github/workflows/ci.yml: 1 path
  rewrite .golangci.yml: 1 path
  rewrite .goreleaser.yaml: 1 path
  rewrite .testcoverage.yml: 2 paths
  rewrite Dockerfile: 1 path
  rewrite Makefile: 4 paths
  rewrite api/delta.openapi.yaml: 1 path
  rewrite api/oapi-delta.yaml: 1 path
  rewrite api/src/delta/paths.yaml: 1 path
  rewrite deploy/platform/terraform/aws/base/Makefile: 1 path
  rewrite docs/client-recipes/src/delta.json: 1 path
  rewrite docs/implementation/package-format-inventory.json: 1 path
  rewrite internal/other/migrations/0002_delta.sql: 1 path
  rewrite internal/web/server.go: 3 imports, 1 path
  rewrite test/acceptance/features/delta.feature: 1 path
  rewrite test/acceptance/run.sh: 1 path
  rewrite tools/depsync/catalog.json: 1 path
  rewrite tools/depsync/sync.py: 1 path
regenerate: make generate (an API specification or its generator configuration changed)
regenerate: go run ./tools/formatinventory (the format inventory changed)
regenerate: make client-recipes (client recipe evidence names a moved path)
regenerate: make fmt (format the changed files)
dry run: nothing changed
