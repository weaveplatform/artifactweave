# -external converts several tests of one package at once. They all land in
# the external test package, so what one of them declares, a helper type with
# its fields and methods, a function and an exported constant, stays in sight
# of the others: it is neither qualified nor reported, and no converted test
# is told that it loses sight of another's declarations. What the package's
# other files declare is still reported: an unexported name of the package,
# a field or method of a package type, including a method that a converted
# test declares on one, and a helper of a test file that stays in the
# package. A test that stays and uses a converted test's helper is reported
# too, and so is each method a converted test declares.
fail fix -ticket PLT-40 -report-only -external internal/core/fixture_test.go internal/core/use_test.go
cmpout want/report
git status --porcelain
! stdout .

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [],
    "files": [],
    "placeholders": []
}
-- internal/core/core.go --
// Package core counts.
package core

// Counter counts.
type Counter struct{ n int }

func (c *Counter) bump() { c.n++ }

// Add adds one.
func Add(c *Counter) { c.bump() }

func secret() int { return 7 }
-- internal/core/fixture_test.go --
package core

import "testing"

type world struct {
	t *testing.T
	c *Counter
}

const Rounds = 3

func newWorld(t *testing.T) *world { return &world{t: t, c: &Counter{}} }

func (w *world) add() { Add(w.c) }

func (c *Counter) twice() {
	c.bump()
	c.bump()
}
-- internal/core/use_test.go --
package core

import "testing"

func TestUnitUse(t *testing.T) {
	w := newWorld(t)
	w.add()
	w.c.twice()
	if w.c.n != Rounds || secret() != 7 || helper() != 1 {
		w.t.Fatal(w.c)
	}
}
-- internal/core/stay_test.go --
package core

import "testing"

func helper() int { return 1 }

func TestUnitStay(t *testing.T) {
	if newWorld(t).c == nil {
		t.Fatal("no counter")
	}
}
