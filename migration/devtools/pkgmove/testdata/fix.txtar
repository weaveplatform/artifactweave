// Package user uses the model.
package user

import (
	"github.com/weaveplatform/artifactweave/internal/core"
	"github.com/weaveplatform/artifactweave/migration/platform/fresh"
)

// Fresh is fresh.
var Fresh = fresh.Other

// Shadow names the model where fresh means something else.
func Shadow() string {
	fresh, platformfresh := "f", "p"
	return fresh + platformfresh + core.Model{}.Kept.Name
}
