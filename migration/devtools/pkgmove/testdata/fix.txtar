# The edges of fix. Its command line and the tree it reads: neither -ticket
# nor -bridges or both, -external without -ticket, a ticket whose file
# entries have not moved or that has none, a moved file that does not parse,
# no bridge to rewrite, and git, make fmt, go.mod and the ledger failing. Its
# repairs: a moved file that uses a bridge of its old package by its bare
# name, in another package or in the bridge's target; a moved file that no
# load compiles; a declaration that moved with an export_test.go; a name that
# a deleted file took along; a generated importer; an import name that a
# local variable shadows; a package of the old one's name, which takes over
# the import name; an importer whose imports stay; and -external on a file
# that no load compiles, on a test that declares a method, and on a test
# whose declarations another test uses, with or without file moves. A
# declaration that clashes in the new package is the compiler's to report.
usage fix
stderr ^pkgmove: usage: fix takes either -ticket or -bridges$
usage fix -ticket PLT-30 -bridges
usage fix -bogus
usage fix -bridges -external internal/core/conv_test.go
stderr ^pkgmove: usage: -external goes with -ticket$
fail fix -ticket PLT-31
stderr ^pkgmove: refused: internal/pend/p\.go is pending; run pkgmove move -ticket PLT-31 first$
fail fix -ticket PLT-39
stderr ^pkgmove: refused: PLT-39 has no file move entry in the ledger; fix repairs what file moves break$
fail fix -ticket PLT-33
stderr ^pkgmove: refused: migration/platform/broken/broken\.go does not parse: 
ok fix -bridges
cmpout want/nobridges
cp want/bridge_kernel.go internal/core/bridge_kernel.go
commit
fail fix -ticket PLT-30 -report-only -external internal/core/conv_test.go internal/core/never_test.go
cmpout want/plan
git status --porcelain
! stdout .
fail fix -ticket PLT-32 -report-only -external internal/core/conv_test.go
cmpout want/external
failgit grep
fail fix -ticket PLT-30
stderr ^pkgmove: git .*grep.*: exit status 128: fake git failure$
failgit
failrun make fmt
fail fix -ticket PLT-30
stderr ^pkgmove: regenerate: fake runner failure: make fmt$
runs make fmt
cmp internal/user/user.go want/user.go
cmp internal/other/other.go want/other.go
cmp migration/platform/fresh/model.go want/model.go
cmp migration/kernel/kern.go want/kern.go
cmp internal/label/label.go want/label.go
failrun
cp want/go.mod go.mod
fail fix -ticket PLT-30
stderr ^pkgmove: type-check the importers for GOOS=linux: 
failgit ^ls-files
fail fix -bridges
stderr ^pkgmove: git ls-files -z: exit status 128: fake git failure$
failgit
cp want/ledger.json migration/ledger.json
fail fix -bridges
stderr ^pkgmove: refused: the ledger does not validate: 
rm migration/ledger.json
fail fix -bridges
stderr ^pkgmove: open the repository: 
