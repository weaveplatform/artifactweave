        {"from":"internal/core/ignored.go","action":"move","to":"platform/fresh","ticket":"PLT-30"},
        {"from":"internal/core/kern.go","action":"move","to":"kernel","ticket":"PLT-30"},
        {"from":"internal/core/legacy.go","action":"delete","ticket":"PLT-30"},
        {"from":"internal/core/model.go","action":"move","to":"platform/fresh","ticket":"PLT-30"},
        {"from":"internal/core/named.go","action":"move","to":"platform/core","ticket":"PLT-30"},
