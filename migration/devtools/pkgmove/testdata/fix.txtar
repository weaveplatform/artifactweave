-- internal/core/core.go --
// Package core keeps what the split leaves.
package core

// Kept stays in core.
type Kept struct {
	Name string
	id   int
}

func (k Kept) reset() Kept { return Kept{Name: k.Name, id: k.id} }

const limit = 2

var counter = 0

type secret struct{}

func helper() int { return limit + counter }

// Uses calls the legacy function, whose file the split deleted.
func Uses() int { return Legacy() }
-- internal/core/conv_test.go --
package core

import "testing"

type probe struct{ n int }

func (p probe) twice() int { return p.n * 2 }

func newProbe() probe { return probe{n: limit} }

func TestUnitConv(t *testing.T) {
	p := newProbe()
	k := Kept{}.reset()
	if p.twice() != 2*limit || counter != 0 || k.id != 0 || helper() == 0 {
		t.Fatal(p, secret{})
	}
}
-- internal/core/use_test.go --
package core

import (
	"os"
	"testing"
)

func TestUnitUse(t *testing.T) {
	if newProbe().n != limit {
		t.Fatal("probe")
	}
	if _, err := os.ReadFile(os.Args[0]); err != nil {
		t.Fatal(err)
	}
}
-- internal/core/never_test.go --
//go:build never

package core

import "testing"

func TestUnitNever(t *testing.T) { _ = Kept{} }
-- internal/core/core_x_test.go --
package core_test

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/core"
)

func TestUnitExported(t *testing.T) {
	if core.Exported() == 0 {
		t.Fatal("zero")
	}
}
