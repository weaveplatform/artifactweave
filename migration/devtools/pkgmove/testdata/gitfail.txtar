# A git command that fails stops the command with an error that names it and
# says what git said; so does a target directory that cannot be created.
failgit ^status
fail move -ticket PLT-60
stderr ^pkgmove: git status --porcelain --untracked-files=no: exit status 128: fake git failure$
failgit ^ls-files --others
fail move -ticket PLT-60
stderr ^pkgmove: git ls-files --others --exclude-standard -z -- internal/p60: exit status 128: fake git failure$
failgit grep .* -l -e
fail move -ticket PLT-60
stderr ^pkgmove: git -c grep\.column=false .* -l -e internal/p60 -- \.: exit status 128: fake git failure$
failgit ^mv
fail move -ticket PLT-60
stderr ^pkgmove: git mv -- internal/p60/p60\.go migration/platform/p60/: exit status 128: fake git failure$
failgit
git clean -fdq
cp want/x.txt migration/platform/p60/testdata
fail move -ticket PLT-60
stderr ^pkgmove: create migration/platform/p60/testdata: \S
git clean -fdq

failgit grep .* -n -e
fail check
stderr ^pkgmove: git .* grep .* -n -e internal/p61 .*: exit status 128: fake git failure$
failgit ^ls-files -z$
fail check
stderr ^pkgmove: git ls-files -z: exit status 128: fake git failure$
failgit
ok move -ticket PLT-60
exists migration/platform/p60/testdata/x.txt

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/p60","action":"move","to":"platform/p60","ticket":"PLT-60"},
        {"from":"internal/p61","action":"move","to":"platform/p61","ticket":"PLT-61"}
    ],
    "files": [],
    "placeholders": []
}
-- internal/p60/p60.go --
// Package p60 is pending.
package p60
-- internal/p60/testdata/x.txt --
x
-- migration/platform/p61/p61.go --
// Package p61 is done.
package p61
-- docs/p60.md --
p60 lives in internal/p60.
-- want/x.txt --
x
