# The edges of file move entries. move refuses an entry whose old path the
# tree does not hold in the shape the entry gives it, two entries that would
# move to one path, an entry that would overwrite a tracked file, and an
# entry that is done; it names the corpus entry, scope included, that a fuzz
# target moving to a repo-scope directory needs. A Go file takes the name of
# the package entry that makes its directory, of its own ticket or another,
# and a test that joins a directory of in-package tests stays one. The
# FUZZ_PKGS entry of a fuzz target's old directory goes when the new one is
# listed already; nothing changes when the old one is not listed, or when
# the Makefile has no FUZZ_PKGS. A package entry leaves a file that has a
# file entry of its own where it is, and the paths that name it, until that
# entry moves it. A directory shared as a whole keeps its inventory key
# while a test stays there, and loses it with the last.
fail move -ticket PLT-41
stderr ^pkgmove: refused: internal/a/a\.go/ is a file; write it without the trailing / in the ledger$
fail move -ticket PLT-42
stderr ^pkgmove: refused: internal/a/none/ holds no tracked file$
fail move -ticket PLT-43
stderr ^pkgmove: refused: internal/a/assets is a directory; write it as internal/a/assets/ in the ledger$
fail move -ticket PLT-44
stderr ^pkgmove: refused: internal/a/gone\.go is not a tracked file$
fail move -ticket PLT-45
stderr ^pkgmove: refused: internal/a/b\.go and internal/a/c\.go would both move to migration/platform/b/same\.go; give one a file name in the ledger$
fail move -ticket PLT-46
stderr ^pkgmove: refused: internal/a/d\.go would overwrite the tracked file migration/platform/b/exists\.go$
fail move -ticket PLT-48
stderr ^pkgmove: refused: internal/z/z_test\.go declares FuzzZ, so its seed corpus internal/z/testdata/fuzz/FuzzZ/ must move with it: give it a file entry of PLT-48 with to "test/fuzzing/testdata/fuzz" and scope "repo"$
ok move -ticket PLT-47
commit
fail move -ticket PLT-47
stderr ^pkgmove: refused: internal/a/e\.go is done, not pending$
ok move -ticket PLT-49
stdout ^  rewrite Makefile: 1 path, 1 fuzz package$
grep Makefile ^FUZZ_PKGS \?= \./migration/platform/pk \./migration/platform/fz$
grep migration/platform/pk/f.go ^package pkx$
commit
ok move -ticket PLT-50
grep migration/platform/later/g.go ^package latter$
commit
ok move -ticket PLT-51
grep migration/platform/t/a_test.go ^package t$
commit
ok move -ticket PLT-53
! stdout Makefile
grep Makefile ^FUZZ_PKGS \?= \./migration/platform/pk \./migration/platform/fz$
commit
cp want/Makefile Makefile
commit
ok move -ticket PLT-54
! stdout Makefile
exists migration/platform/f3/three_test.go migration/platform/f3/testdata/fuzz/FuzzThree/seed
commit
ok move -ticket PLT-62
exists internal/m/keep_test.go migration/platform/m/m.go
cmp docs/m.md want/m-after-package.md
commit
ok move -ticket PLT-63
exists migration/platform/k/keep_test.go
cmp docs/m.md want/m-after-file.md
commit
ok move -ticket PLT-64
grep tools/citestselection/test_ownership.json "internal/server": "shared"
commit
ok move -ticket PLT-65
! grep tools/citestselection/test_ownership.json internal/server
grep tools/citestselection/test_ownership.json "a_test\.go",
go vet ./...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- Makefile --
FUZZ_PKGS ?= ./internal/pk ./internal/f1 ./migration/platform/fz

fuzz:
	go test -run '^Fuzz' $(FUZZ_PKGS)
