# promote refuses until every entry is done and the legacy roots are empty,
# and will not move a staged directory into an existing one; after the
# rename its check reports what still names an old path.
fail promote
stderr ^pkgmove: refused: every entry must be done first: internal/beta2 is pending; internal/beta2/data\.txt is pending$
cp want/beta2.go migration/platform/beta2/beta2.go
cp want/data.txt migration/platform/bdata/data.txt
git rm -q internal/beta2/beta2.go internal/beta2/data.txt
commit
fail promote
stderr ^pkgmove: refused: the legacy roots still hold tracked files: internal/README\.md$
git rm -q internal/README.md
commit
cp want/data.txt internal/platform/x.txt
fail promote
stderr ^pkgmove: refused: internal/platform already exists, so git mv would move migration/platform into it$
git clean -fdq

# A git command that fails, or a directory or file that cannot be written,
# stops promote with an error that names it.
failgit ^ls-files -z -- internal
fail promote
stderr ^pkgmove: git ls-files -z -- internal pkg/aql .*: exit status 128: fake git failure$
failgit grep .* -l -e
fail promote
stderr ^pkgmove: git .* grep .* -l -e .*: exit status 128: fake git failure$
failgit ^mv
fail promote
stderr ^pkgmove: git mv -- migration/platform internal/platform: exit status 128: fake git failure$
failgit ^rm
git reset -q --hard
git clean -fdq
fail promote
stderr ^pkgmove: git rm -q -- migration/ledger\.json: exit status 128: fake git failure$
failgit ^add
git reset -q --hard
git clean -fdq
fail promote
stderr ^pkgmove: git add -- docs/implementation/p9d-path-map\.json: exit status 128: fake git failure$
failgit 1 ^ls-files -z$
git reset -q --hard
git clean -fdq
fail promote
stderr ^pkgmove: git ls-files -z: exit status 128: fake git failure$
failgit
git reset -q --hard
git clean -fdq
cp want/data.txt docs/implementation
fail promote
stderr ^pkgmove: create docs/implementation: \S
git reset -q --hard
git clean -fdq
cp want/data.txt docs/implementation/p9d-path-map.json/x
fail promote
stderr ^pkgmove: write docs/implementation/p9d-path-map\.json: \S
git reset -q --hard
git clean -fdq
failgit grep .* -n -e
fail promote
stderr ^pkgmove: git .* grep .* -n -e .*: exit status 128: fake git failure$
failgit
git reset -q --hard
git clean -fdq
cp want/bad-ownership.json tools/citestselection/test_ownership.json
commit
fail promote
stderr ^pkgmove: decode tools/citestselection/test_ownership\.json: json: unknown field "colour"$
git rm -q tools/citestselection/test_ownership.json
commit

failrun make generate
fail promote
stderr ^pkgmove: regenerate: fake runner failure: make generate$
git reset -q --hard
git clean -fdq
failrun
fail promote
runs make generate; make fmt
stdout ^internal/platform/gen/g/g\.gen\.go:6: stale path "migration/platform/alpha2": migration/platform moved; write "internal/platform/alpha2"$
stdout ^notes\.txt:1: stale path "internal/alpha2": PLT-50 moved internal/alpha2 to internal/platform/alpha2; write "internal/platform/alpha2"$
stdout ^notes\.txt:1: stale path "migration/platform/alpha2": migration/platform moved; write "internal/platform/alpha2"$
usage promote extra
usage promote -bogus

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/alpha2","action":"move","to":"platform/alpha2","ticket":"PLT-50"},
        {"from":"internal/beta2","action":"move","to":"platform/beta2","ticket":"PLT-51"}
    ],
    "files": [
        {"from":"internal/beta2/data.txt","action":"move","to":"platform/bdata","ticket":"PLT-51"}
    ],
    "placeholders": []
}
-- internal/README.md --
A stray document in a legacy root.
-- internal/beta2/beta2.go --
// Package beta2 is pending.
package beta2
-- internal/beta2/data.txt --
data
-- migration/platform/alpha2/alpha2.go --
// Package alpha2 is staged.
package alpha2

// Alpha2 is alpha2.
type Alpha2 string
-- migration/platform/gen/g/g.gen.go --
// Code generated by oapi-codegen. DO NOT EDIT.

// Package g is generated.
package g

import "github.com/weaveplatform/artifactweave/migration/platform/alpha2"

// G is generated.
type G = alpha2.Alpha2
-- notes.txt --
see migration/platform/alpha2 and internal/alpha2
-- want/beta2.go --
// Package beta2 is staged.
package beta2
-- want/bad-ownership.json --
{"version": 2, "packages": {"migration/platform/alpha2": "shared"}, "colour": "blue"}
-- want/data.txt --
data
