# A move runs only the regeneration steps it needs, in order, stops at the
# first that fails, and then checks: a generated file is never edited, so
# until its generator runs, the old path in it is stale.
failrun make generate
fail move -ticket PLT-30
runs make generate
stderr ^pkgmove: regenerate: fake runner failure: make generate$
git reset -q --hard

fail move -ticket PLT-30 -no-regenerate
runs
! stdout ^run
git reset -q --hard

failrun
ok move -ticket PLT-30 -dry-run
fail move -ticket PLT-30
cmpout want/plan
runs make generate; make client-recipes; make api-ledger; make fmt
git reset -q --hard

# Moving a generator asks for make generate too.
ok move -ticket PLT-31
runs make generate; make fmt
stdout ^regenerate: make generate \(a generator or a generated file moved or changed\)$

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/omega","action":"move","to":"platform/omega","ticket":"PLT-30"},
        {"from":"internal/demo/stubgen","action":"move","to":"platform/stubgen","ticket":"PLT-31"}
    ],
    "files": [],
    "placeholders": []
}
-- internal/omega/omega.go --
// Package omega is used by generated code.
package omega

// Omega is omega.
type Omega string
-- internal/demo/stubgen/stubgen.go --
// Package stubgen generates stubs.
package stubgen
-- internal/server/gen/g/g.gen.go --
// Code generated by oapi-codegen. DO NOT EDIT.

// Package g is generated.
package g

import "github.com/weaveplatform/artifactweave/internal/omega"

// G is generated.
type G = omega.Omega
-- docs/client-recipes/evidence-lock.json --
{"internal/omega/omega.go": "sha256:0"}
-- docs/research/api-reliability/operations.json --
{"handler": "github.com/weaveplatform/artifactweave/internal/omega.Omega"}
-- want/plan --
move internal/omega -> migration/platform/omega [PLT-30]
  git mv internal/omega/omega.go migration/platform/omega/omega.go
regenerate: make generate (generated code names a moved path)
regenerate: make client-recipes (client recipe evidence names a moved path)
regenerate: make api-ledger (the API reliability ledger names a moved path)
regenerate: make fmt (format the changed files)
run make generate (generated code names a moved path)
run make client-recipes (client recipe evidence names a moved path)
run make api-ledger (the API reliability ledger names a moved path)
run make fmt (format the changed files)
docs/client-recipes/evidence-lock.json:1: stale path "internal/omega/omega.go": PLT-30 moved internal/omega to migration/platform/omega; write "migration/platform/omega/omega.go"
docs/research/api-reliability/operations.json:1: stale path "internal/omega": PLT-30 moved internal/omega to migration/platform/omega; write "migration/platform/omega"
internal/server/gen/g/g.gen.go:6: stale path "internal/omega": PLT-30 moved internal/omega to migration/platform/omega; write "migration/platform/omega"
