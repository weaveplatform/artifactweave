# A package that moves into a directory named otherwise, as an ecosystem
# slice's protocol package becomes <type>http in http/: an importer that
# named it without an import name has its qualifiers renamed and gets the new
# name as its import name, so goimports, which make fmt runs next, has no
# second import of the same path to add beside net/http's.
ok move -ticket ECO-01 -dry-run
stdout ^  rewrite internal/server/server\.go: 1 import, 1 qualifier, 1 import name$
stdout ^  rewrite internal/server/zeta/zeta_test\.go \(at migration/artifacts/ecosystem/zeta/http/zeta_test\.go\): 1 import, 1 qualifier, 1 import name, 1 package clause$
ok move -ticket ECO-01
runs make fmt
cmp internal/server/server.go want/server.go
cmp migration/artifacts/ecosystem/zeta/http/zeta.go want/zeta.go
cmp migration/artifacts/ecosystem/zeta/http/zeta_test.go want/zeta_test.go
go vet ./...

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/server/zeta","action":"move","to":"artifacts/ecosystem/zeta/http","name":"zetahttp","ticket":"ECO-01"}
    ],
    "files": [],
    "placeholders": []
}
-- internal/server/server.go --
// Package server mounts zeta.
package server

import (
	"net/http"

	"github.com/weaveplatform/artifactweave/internal/server/zeta"
)

// Mount serves zeta at /zeta.
func Mount(m *http.ServeMux) { m.Handle("/zeta", zeta.Handler()) }
-- internal/server/zeta/zeta.go --
// Package zeta serves zeta.
package zeta

import "net/http"

// Handler answers every request with 204.
func Handler() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	})
}
-- internal/server/zeta/zeta_test.go --
package zeta_test

import (
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/weaveplatform/artifactweave/internal/server/zeta"
)

func TestZeta(t *testing.T) {
	w := httptest.NewRecorder()
	zeta.Handler().ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/", nil))
	if w.Code != http.StatusNoContent {
		t.Fatal(w.Code)
	}
}
-- want/server.go --
// Package server mounts zeta.
package server

import (
	"net/http"

	zetahttp "github.com/weaveplatform/artifactweave/migration/artifacts/ecosystem/zeta/http"
)

// Mount serves zeta at /zeta.
func Mount(m *http.ServeMux) { m.Handle("/zeta", zetahttp.Handler()) }
-- want/zeta.go --
// Package zetahttp serves zeta.
package zetahttp

import "net/http"

// Handler answers every request with 204.
func Handler() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	})
}
-- want/zeta_test.go --
