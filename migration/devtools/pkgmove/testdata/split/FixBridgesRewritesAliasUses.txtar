        {"from":"internal/differ","action":"move","to":"platform/differ","ticket":"PLT-90"},
        {"from":"internal/embed","action":"move","to":"platform/embed","ticket":"PLT-90"},
        {"from":"internal/only","action":"move","to":"platform/only","ticket":"PLT-90"},
        {"from":"internal/store","action":"split","ticket":"PLT-01"}
    ],
    "files": [],
    "placeholders": []
}
-- migration/kernel/kernel.go --
// Package kernel holds what every module shares.
package kernel

import "errors"

// ErrNotFound reports a missing record.
var ErrNotFound = errors.New("store: not found")

// DefaultLimit is the default page size.
const DefaultLimit = 50

// Page is a page request.
type Page struct {
	Limit int
	Key   string
}

// Cursor returns the page's cursor.
func Cursor(p Page) string { return p.Key }

// Trim cuts rows to limit.
func Trim[T any](rows []T, limit int) []T {
	if len(rows) > limit {
		return rows[:limit]
	}
	return rows
}

// Pair pairs a key and a value.
type Pair[K comparable, V any] struct {
	Key K
	Val V
}

// Named is embedded.
type Named struct{ Name string }

// Differ counts s.
func Differ(s string) int { return len(s) }

// Clone returns v.
func Clone[V any](v V) V { return v }
-- internal/store/bridge_kernel.go --
// Bridge (P9d): declared in migration/kernel; PRO-02 deletes it.

package store

import "github.com/weaveplatform/artifactweave/migration/kernel"

var ErrNotFound = kernel.ErrNotFound

const DefaultLimit = kernel.DefaultLimit

type Page = kernel.Page

var Cursor = kernel.Cursor

func Trim[T any](rows []T, limit int) []T { return kernel.Trim(rows, limit) }

type Pair[K comparable, V any] = kernel.Pair[K, V]

type Embedded = kernel.Named

func Differ(s string) int64 { return int64(kernel.Differ(s)) }

func Clone(v any) any { return kernel.Clone(v) }
-- internal/store/store.go --
// Package store stores records.
package store

// Get gets the page.
func Get(p Page) error {
	if p.Limit > DefaultLimit {
		return ErrNotFound
	}
	return nil
}
-- internal/alpha/alpha.go --
// Package alpha uses the store.
package alpha

import (
	"errors"

	"github.com/weaveplatform/artifactweave/internal/store"
)

// App pages rows.
func App(rows []string) ([]string, string, bool) {
	p := store.Page{Limit: 2}
	err := store.Get(p)
	pair := store.Pair[string, int]{Key: "k", Val: 1}
	return store.Trim(rows, p.Limit), store.Cursor(p) + pair.Key, errors.Is(err, store.ErrNotFound)
}
-- internal/alpha/alpha_test.go --
package alpha

import (
	"testing"

	"github.com/weaveplatform/artifactweave/internal/store"
)

func TestUnitApp(t *testing.T) {
	store.Cursor = func(store.Page) string { return "c" }
	if _, c, _ := App(nil); c != "ck" {
		t.Fatal(c)
	}
}
-- internal/only/only.go --
// Package only uses only bridges, and the kernel already.
package only

import (
	"github.com/weaveplatform/artifactweave/internal/store"
	"github.com/weaveplatform/artifactweave/migration/kernel"
)

// Only returns the default limit.
func Only() int { return store.DefaultLimit + len(kernel.Cursor(store.Page{})) }
-- internal/embed/embed.go --
// Package embed embeds bridged types.
package embed

import "github.com/weaveplatform/artifactweave/internal/store"

// Wrapper embeds a renamed alias.
type Wrapper struct {
	store.Embedded
}

// Holder embeds an alias of the same name.
type Holder struct {
	*store.Page
}
-- internal/differ/differ.go --
// Package differ calls a wrapper with another signature.
package differ

import "github.com/weaveplatform/artifactweave/internal/store"

// Differ counts.
func Differ() int64 { return store.Differ("x") }

// Clone clones.
func Clone() any { return store.Clone(1) }
