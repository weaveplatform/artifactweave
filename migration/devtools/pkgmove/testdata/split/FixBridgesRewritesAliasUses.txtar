# fix -bridges points every use of a bridge declaration at the declaration it
# aliases: type aliases, generic ones included, var and const aliases, and
# wrappers whose signature is the target's. Imports are added and those left
# unused dropped; the bridge files stay as they are. What it cannot rewrite is
# reported: an embedded field that would change its name, a wrapper whose
# signature differs, an assignment to a var bridge. -report-only plans the
# same and changes nothing.
go build ./...
fail fix -bridges -report-only
cmpout want/plan
git status --porcelain
! stdout .
fail fix -bridges
runs make fmt
cmp internal/store/store.go want/store.go
cmp internal/alpha/alpha.go want/alpha.go
cmp internal/alpha/alpha_test.go want/alpha_test.go
cmp internal/only/only.go want/only.go
cmp internal/embed/embed.go want/embed.go
cmp internal/store/bridge_kernel.go want/bridge_kernel.go
go vet ./...
-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
