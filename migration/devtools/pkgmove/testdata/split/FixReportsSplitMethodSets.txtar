# A method cannot be declared outside its receiver type's package, so fix
# reports a method that a split separated from its type, whichever of the two
# moved, instead of qualifying the receiver.
ok move -ticket PLT-12
commit
fail fix -ticket PLT-12 -report-only
cmpout want/report

