-- internal/model/model.go --
// Package model models items.
package model

// Item is an item.
type Item struct{ ID string }

// Name names the item.
func (i Item) Name() string { return i.ID }
-- internal/model/item_json.go --
package model

// MarshalJSON writes the item's ID.
func (i Item) MarshalJSON() ([]byte, error) { return []byte(`"` + i.ID + `"`), nil }
-- internal/model/types.go --
package model

// Tag tags an item.
type Tag string
-- internal/model/tag_methods.go --
package model

// String returns the tag.
func (t Tag) String() string { return string(t) }
