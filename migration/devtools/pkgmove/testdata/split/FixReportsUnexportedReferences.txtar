# An unexported name that a split puts on the other side of a package
# boundary cannot be qualified: fix reports each use, in a moved file and in
# a file that stayed, and a test helper that a moved test can no longer
# reach. The report exits 1 and changes nothing it cannot fix.
ok move -ticket PLT-10
commit
fail fix -ticket PLT-10
cmpout want/report
git status --porcelain
! stdout .

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/queue","action":"split","ticket":"PLT-11"}
    ],
    "files": [
        {"from":"internal/queue/limits.go","action":"move","to":"platform/limits","ticket":"PLT-10"},
        {"from":"internal/queue/limits_test.go","action":"move","to":"platform/limits","ticket":"PLT-10"}
    ],
    "placeholders": []
}
-- internal/queue/queue.go --
// Package queue queues.
package queue

const factor = 2

// Push reports whether a queue of n may grow.
func Push(n int) bool { return n < limit() }
-- internal/queue/helpers_test.go --
package queue

func newQueue() []int { return nil }
-- internal/queue/limits.go --
package queue

func limit() int { return 10 }

// Max is the largest queue.
func Max() int { return limit() * factor }
-- internal/queue/limits_test.go --
package queue

import "testing"

func TestUnitMax(t *testing.T) {
	if len(newQueue()) > Max() {
		t.Fatal(Max())
	}
}
