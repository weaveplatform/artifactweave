move file internal/gamma/scope.go -> migration/platform/delta/scope.go [PLT-06]
move file internal/gamma/scope_test.go -> migration/platform/delta/scope_test.go [PLT-06]
move file internal/gamma/testdata/fuzz/FuzzParseScope/ -> migration/platform/delta/testdata/fuzz/FuzzParseScope/ [PLT-06]
  git mv internal/gamma/scope.go migration/platform/delta/scope.go
  git mv internal/gamma/scope_test.go migration/platform/delta/scope_test.go
  git mv internal/gamma/testdata/fuzz/FuzzParseScope/seed1 migration/platform/delta/testdata/fuzz/FuzzParseScope/seed1
