{
  "version": 2,
  "packages": {
    "internal/server": "shared",
    "test/server/artifacts/maven": "maven",
    "test/server/artifacts/npm": "shared",
    "test/server/npm": "npm"
  },
  "shared_files": {
    "internal/server": [
      "stay_test.go"
