# check reports every reference to the old path of a done entry outside the
# history set, says what to write instead, and leaves alone the paths that
# are still right: a pending entry, a subpackage with its own pending entry
# and the directory prefix of a package whose subpackages have not all moved.
fail check
cmpout want/check
! stderr .
fail check -ticket PLT-06
stdout ^notes\.txt:1:
! stdout ^notes\.txt:3:
ok check -ticket PLT-08
stdout ^check: no stale paths \(0 old paths checked\)$

# A move whose old path stays in a file outside the rewrite set fails its
# own check, after the move.
fail move -ticket PLT-08
stdout ^notes\.txt:5: stale path "internal/nu": PLT-08 moved internal/nu to migration/platform/nu; write "migration/platform/nu"$
exists migration/platform/nu/nu.go
commit

# -skip exempts files from the text rewrite; their imports still move.
fail move -ticket PLT-09 -skip internal/omicron/*.go -skip docs/*
cmp internal/omicron/omicron.go want/omicron.go
cmp docs/xi.md want/xi.md
stdout ^docs/xi\.md:1:
stdout ^internal/omicron/omicron\.go:7:
commit

# check -from checks a directory that was re-homed without the ledger.
fail check -from migration/platform/nu
stderr ^pkgmove: refused: migration/platform/nu still holds Go files$
fail check -from migration/platform/pi
stdout ^notes\.txt:6: stale path "migration/platform/pi/pi\.go": migration/platform/pi moved$
usage check -ticket PLT-06 -from migration/platform/pi
usage check extra

-- go.mod --
module github.com/weaveplatform/artifactweave

go $GOVERSION
-- migration/ledger.json --
{
    "schema": 1,
    "module": "github.com/weaveplatform/artifactweave",
    "staging_root": "migration",
    "final_root": "internal",
    "packages": [
        {"from":"internal/kappa","action":"move","to":"platform/kappa","ticket":"PLT-06"},
        {"from":"internal/kappa/sub","action":"move","to":"platform/kappa/sub","ticket":"PLT-07"},
        {"from":"internal/lambda","action":"split","ticket":"ACC-01"},
        {"from":"internal/mu","action":"delete","ticket":"ACC-02"},
        {"from":"internal/nu","action":"move","to":"platform/nu","ticket":"PLT-08"},
        {"from":"internal/xi","action":"move","to":"platform/xi","ticket":"PLT-09"}
    ],
    "files": [],
    "placeholders": []
}
-- CHANGELOG.md --
- internal/kappa moved, and internal/lambda split.
-- notes.txt --
kappa moved: internal/kappa/kappa.go
the prefix internal/kappa/ stays while internal/kappa/sub is pending
lambda was split: internal/lambda
mu was deleted: internal/mu
nu still lives in internal/nu
pi was re-homed from migration/platform/pi/pi.go
-- migration/platform/kappa/kappa.go --
// Package kappa has moved.
package kappa
-- internal/kappa/sub/sub.go --
// Package sub is pending.
package sub
-- internal/nu/nu.go --
// Package nu is pending.
package nu
-- internal/xi/xi.go --
// Package xi is pending.
package xi

// Xi is xi.
const Xi = "xi"
-- internal/omicron/omicron.go --
// Package omicron imports xi.
package omicron

import "github.com/weaveplatform/artifactweave/internal/xi"

// Fixture names xi's fixtures.
const Fixture = "internal/xi/testdata/" + xi.Xi
-- docs/xi.md --
xi lives in internal/xi.
-- want/check --
notes.txt:1: stale path "internal/kappa/kappa.go": PLT-06 moved internal/kappa to migration/platform/kappa; write "migration/platform/kappa/kappa.go"
notes.txt:3: stale path "internal/lambda": ACC-01 split or deleted internal/lambda
notes.txt:4: stale path "internal/mu": ACC-02 split or deleted internal/mu
-- want/omicron.go --
// Package omicron imports xi.
package omicron

import "github.com/weaveplatform/artifactweave/migration/platform/xi"

// Fixture names xi's fixtures.
const Fixture = "internal/xi/testdata/" + xi.Xi
-- want/xi.md --
xi lives in internal/xi.
