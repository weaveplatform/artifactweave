{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Documentation for editors. migration/devtools/ledger is authoritative: its Validate adds the rules a schema cannot express, and TestUnitSchemaAgreesWithValidator keeps the constants, enums, patterns and field names below equal to the Go ones.",
  "title": "P9d migration ledger (decision 0044)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "staging_root", "final_root", "packages", "files", "placeholders"],
  "properties": {
    "schema": {"const": 1},
    "module": {"const": "github.com/weaveplatform/artifactweave"},
    "staging_root": {"const": "migration"},
    "final_root": {"const": "internal"},
    "packages": {"type": "array", "items": {"$ref": "#/$defs/package"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "placeholders": {"type": "array", "items": {"$ref": "#/$defs/placeholder"}}
  },
  "$defs": {
    "legacy": {"type": "string", "pattern": "^(internal|pkg/(aql|blob|cdn|layout|repo|store|types))(/[a-z0-9_]+)*$"},
    "legacyFile": {"type": "string", "pattern": "^(internal|pkg/(aql|blob|cdn|layout|repo|store|types))(/[A-Za-z0-9_.-]+)+/?$"},
    "target": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*$"},
    "scope": {"enum": ["root", "repo"]},
    "ticket": {"type": "string", "pattern": "^(FND|SKL|PLT|STO|ACC|ART|RMT|ECO|WEB|TST|PRO)-[0-9]{2}$"},
    "phase": {"type": "string", "pattern": "^P[0-9]{1,2}[a-z]?$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "action", "ticket"],
      "properties": {
        "from": {"$ref": "#/$defs/legacy"},
        "action": {"enum": ["move", "merge", "split", "delete"]},
        "to": {"$ref": "#/$defs/target"},
        "scope": {"$ref": "#/$defs/scope"},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
        "rename": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+$"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
        },
        "ticket": {"$ref": "#/$defs/ticket"},
        "note": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"action": {"enum": ["move", "merge"]}}}, "then": {"required": ["to"]}},
        {
          "if": {"properties": {"action": {"enum": ["split", "delete"]}}},
          "then": {"not": {"anyOf": [{"required": ["to"]}, {"required": ["name"]}, {"required": ["rename"]}]}}
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "action", "ticket"],
      "properties": {
        "from": {"$ref": "#/$defs/legacyFile"},
        "action": {"enum": ["move", "split", "delete"]},
        "to": {"$ref": "#/$defs/target"},
        "scope": {"$ref": "#/$defs/scope"},
        "file": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "targets": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/target"}},
        "ticket": {"$ref": "#/$defs/ticket"},
        "note": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"action": {"const": "move"}}}, "then": {"required": ["to"]}},
        {"if": {"properties": {"action": {"const": "split"}}}, "then": {"required": ["targets"]}}
      ]
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "phases"],
      "properties": {
        "to": {"$ref": "#/$defs/target"},
        "scope": {"$ref": "#/$defs/scope"},
        "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
        "note": {"type": "string"}
      }
    }
  }
}
