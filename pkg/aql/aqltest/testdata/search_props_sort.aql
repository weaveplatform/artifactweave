items.find({"@build.name":"app","type":"file","$or":[{"$and":[{"repo":"libs-local","path":{"$match":"*"},"name":{"$match":"*"}}]}]}).include("name","repo","path","actual_md5","actual_sha1","sha256","size","type","modified","created","property").sort({"$desc":["created"]}).offset(0).transitive().limit(10)